<% content_for :title, "#{t('contact.title')} · PhoneRelax" %>
<% content_for :description, t('contact.meta_description') %>
<div class="container section" style="max-width: 720px;">
  <h1><%= t('contact.title') %></h1>
  <p><%= t('contact.about') %></p>

  <div class="contact-details">
    <p>
      📍 C/ Carrasqueta, 14 · Pol. Ind. Salinetas · Petrer 03610 (Alicante) · <%= t('common.country') %><br>
      📞 <a href="tel:+34965371962">(+34) 965 371 962</a><br>
      ✉️ <%= mail_to 'info@phonerelax.com' %><br>
      💬 <a href="https://wa.me/34686341700" target="_blank" rel="noopener">WhatsApp: (+34) 686 341 700</a>
    </p>
    <%# El PIN se centra con las coordenadas exactas de la sede (C/ Carrasqueta, 14):
        con la dirección en texto el geocoder fallaba y el mapa salía sin marcador. %>
    <iframe class="contact-map" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
            src="https://maps.google.com/maps?q=38.470682,-0.7761013&z=17&output=embed"
            title="<%= t('contact.map_title') %>"></iframe>
  </div>

  <h2><%= t('contact.form_title') %></h2>
  <p><%= t('contact.intro_html') %></p>
  <%= form_with model: @contact_message, url: contact_messages_path, local: true do |f| %>
    <%= invisible_captcha %>
    <% if @contact_message.errors.any? %>
      <div class="errors"><ul><% @contact_message.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul></div>
    <% end %>
    <div class="form-grid">
      <div><%= f.label :name, t('contact.name') %><%= f.text_field :name %></div>
      <div><%= f.label :email, t('contact.email') %><%= f.email_field :email %></div>
      <div class="full"><%= f.label :phone, t('contact.phone') %><%= f.telephone_field :phone %></div>
      <div class="full"><%= f.label :message, t('contact.message') %><%= f.text_area :message, rows: 6 %></div>
    </div>
    <p><%= f.submit t('contact.submit'), class: 'btn btn-primary' %></p>
  <% end %>
</div>
