<h1>Mensajes de contacto</h1>
<% if @messages.empty? %>
  <p>No hay mensajes.</p>
<% else %>
  <table class="table">
    <thead><tr><th>Fecha</th><th>Nombre</th><th>Contacto</th><th>Mensaje</th><th></th></tr></thead>
    <tbody>
      <% @messages.each do |message| %>
        <tr>
          <td class="text-nowrap"><%= l message.created_at, format: :short %></td>
          <td><%= message.name %></td>
          <td><%= mail_to message.email %><% if message.phone.present? %><br><%= message.phone %><% end %></td>
          <td><%= simple_format message.message %></td>
          <td><%= button_to 'Borrar', admin_contact_message_path(message), method: :delete, class: 'btn-danger-link', form: { data: { turbo_confirm: '¿Borrar este mensaje?' } } %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
