<p><%= link_to '← Volver a pedidos', admin_orders_path %></p>
<h1>Pedido <%= @order.number %></h1>

<p>
  Pago: <span class="badge <%= @order.payment_status %>"><%= @order.payment_status %></span>
  &nbsp; Estado: <span class="badge <%= @order.status %>"><%= @order.status %></span>
  <% if @order.next_status %>
    &nbsp; <%= button_to "Marcar como #{@order.next_status}", advance_admin_order_path(@order), method: :patch, class: 'btn btn-primary', style: 'display:inline-block;' %>
  <% end %>
</p>

<h2>Cliente</h2>
<p>
  <%= @order.customer_name %> · <%= mail_to @order.email %><br>
  <% if @order.phone.present? %>Tel: <%= @order.phone %><br><% end %>
  <% if @order.address.present? %>Envío: <%= [@order.address, @order.postal_code, @order.city, @order.province, @order.country].compact_blank.join(', ') %><% end %>
</p>

<h2>Líneas</h2>
<table class="table">
  <tbody>
    <% @order.order_lines.each do |line| %>
      <tr>
        <td><%= line.product.name %></td>
        <td class="num"><%= line.quantity %> × <%= number_to_currency(line.unit_price, unit: '€', format: '%n %u') %></td>
        <td class="num"><%= number_to_currency(line.subtotal, unit: '€', format: '%n %u') %></td>
      </tr>
    <% end %>
    <tr class="total-row"><td colspan="2">Total</td><td class="num"><%= number_to_currency(@order.total, unit: '€', format: '%n %u') %></td></tr>
  </tbody>
</table>

<p style="color: var(--muted); font-size: 13px;">Creado el <%= l @order.created_at, format: :long %> · Stripe: <%= @order.stripe_session_id.presence || '—' %></p>
