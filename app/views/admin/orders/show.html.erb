<p><%= link_to '← Volver a pedidos', admin_orders_path %> · <%= link_to '🖨 Imprimir albarán', packing_slip_admin_order_path(@order), target: '_blank', rel: 'noopener' %></p>
<h1>Pedido <%= @order.number %></h1>

<p>
  Idioma del pedido: <strong><%= { 'es' => '🇪🇸 Español', 'pt' => '🇵🇹 Portugués', 'en' => '🇬🇧 Inglés' }[@order.locale] || @order.locale %></strong>
</p>
<div class="order-actions" style="margin: 14px 0 24px; padding: 16px; background: var(--card-bg); border: 1px solid var(--border); border-radius: var(--radius);">
  <p style="margin-top:0;">
    <strong>Pago:</strong> <span class="badge <%= @order.payment_status %>"><%= @order.payment_status %></span>
    <% if @order.paid_manually? %><span style="color: var(--muted); font-size: 13px;">(cobro manual)</span><% end %>
    &nbsp;&nbsp; <strong>Estado:</strong> <span class="badge <%= @order.status %>"><%= @order.status %></span>
  </p>

  <% if @order.pago_pendiente? %>
    <div style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:12px;">
      <%= button_to 'Marcar como pagado (cobro manual)', mark_paid_admin_order_path(@order), method: :post,
                    class: 'btn btn-primary',
                    form: { data: { turbo_confirm: "¿Marcar el pedido #{@order.number} como pagado? Se descontará stock y se enviará el email de confirmación al cliente." } } %>
      <%= button_to 'Enviar recordatorio de pago', payment_reminder_admin_order_path(@order), method: :post,
                    class: 'btn btn-outline',
                    form: { data: { turbo_confirm: "¿Enviar el recordatorio de pago a #{@order.email}?" } } %>
    </div>
  <% end %>

  <% if @order.pago_pagado? %>
    <%= form_with url: refund_admin_order_path(@order), method: :post, data: { turbo: false },
                  onsubmit: "return confirm('¿Reembolsar el importe indicado del pedido #{@order.number}?#{@order.paid_manually? ? '' : ' Se devolverá a la tarjeta del cliente a través de Stripe.'}')" do %>
      <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:flex-end; margin-bottom:4px;">
        <div><label style="font-size:13px; color:var(--muted);">Importe a reembolsar (€)</label><br>
          <input type="number" name="amount" step="0.01" min="0.01" max="<%= @order.refundable_amount %>"
                 value="<%= format('%.2f', @order.refundable_amount) %>" class="orders-search-input" style="width:150px;" required></div>
        <button type="submit" class="btn btn-outline">Reembolsar</button>
      </div>
      <% if @order.refunded_amount.positive? %>
        <p style="margin:4px 0 8px; color:var(--muted); font-size:13px;">Ya reembolsado: <%= format('%.2f', @order.refunded_amount) %> € de <%= format('%.2f', @order.amount_paid) %> € cobrados.</p>
      <% end %>
    <% end %>
  <% elsif @order.pago_reembolsado? %>
    <p style="margin:0 0 12px; color:var(--muted);">Devuelto íntegramente al cliente: <%= format('%.2f', @order.refunded_amount) %> €<%= @order.paid_manually? ? ' (cobro manual, devolución registrada a mano)' : ' vía Stripe' %>.</p>
  <% end %>

  <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:flex-end;">
    <% if @order.next_status == 'enviado' %>
      <%= form_with url: advance_admin_order_path(@order), method: :patch, data: { turbo: false } do %>
        <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:flex-end;">
          <div><label style="font-size:13px; color:var(--muted);">Transportista</label><br>
            <input type="text" name="tracking_carrier" placeholder="Correos, SEUR…" class="orders-search-input" style="width:150px;"></div>
          <div><label style="font-size:13px; color:var(--muted);">Nº de seguimiento</label><br>
            <input type="text" name="tracking_number" placeholder="(opcional)" class="orders-search-input" style="width:170px;"></div>
          <button type="submit" class="btn btn-primary">Marcar como enviado</button>
        </div>
      <% end %>
    <% elsif @order.next_status %>
      <%= button_to "Marcar como #{@order.next_status}", advance_admin_order_path(@order), method: :patch,
                    class: 'btn btn-primary',
                    form: { data: { turbo_confirm: "¿Marcar el pedido #{@order.number} como #{@order.next_status}?" } } %>
    <% end %>

    <% if @order.previous_status %>
      <%= button_to "↩ Deshacer (volver a #{@order.previous_status})", revert_admin_order_path(@order), method: :patch,
                    class: 'btn btn-outline',
                    form: { data: { turbo_confirm: "¿Revertir el pedido #{@order.number} a #{@order.previous_status}?" } } %>
    <% end %>
  </div>

  <% if @order.tracking_number.present? || @order.tracking_carrier.present? %>
    <p style="margin:12px 0 0;">📦 <strong>Envío:</strong> <%= @order.tracking_carrier.presence %><%
      if @order.tracking_url %> · <%= link_to @order.tracking_number, @order.tracking_url, target: '_blank', rel: 'noopener' %><%
      elsif @order.tracking_number.present? %> · <%= @order.tracking_number %><% end %></p>
  <% end %>

  <div style="margin-top:14px; padding-top:12px; border-top:1px solid var(--border);">
    <% if @order.deletable? %>
      <%= button_to '🗑 Borrar pedido', admin_order_path(@order), method: :delete, class: 'btn-danger-link',
                    form: { data: { turbo_confirm: "¿Borrar definitivamente el pedido #{@order.number}?#{' Las unidades volverán al stock.' if @order.pago_reembolsado?} Esta acción no se puede deshacer." } } %>
    <% else %>
      <p style="margin:0; color:var(--muted); font-size:13px;">Este pedido no se puede borrar: tiene dinero cobrado. Reembólsalo antes si de verdad quieres eliminarlo.</p>
    <% end %>
  </div>
</div>

<h2>Cliente</h2>
<table class="table" style="max-width: 620px;">
  <tbody>
    <tr><th>Nombre</th><td><%= @order.customer_name %></td></tr>
    <tr><th>Email</th><td><%= mail_to @order.email %></td></tr>
    <tr><th>Teléfono</th><td><%= @order.phone.presence || '—' %></td></tr>
    <tr><th>Dirección</th><td><%= @order.address.presence || '—' %></td></tr>
    <tr><th>Código postal</th><td><%= @order.postal_code.presence || '—' %></td></tr>
    <tr><th>Ciudad</th><td><%= @order.city.presence || '—' %></td></tr>
    <tr><th>Provincia</th><td><%= @order.province.presence || '—' %></td></tr>
    <tr><th>País</th><td><%= @order.country.presence || '—' %></td></tr>
  </tbody>
</table>

<h2>Líneas</h2>
<table class="table">
  <tbody>
    <% @order.order_lines.each do |line| %>
      <tr>
        <td><%= line.product.name %></td>
        <td class="num"><%= line.quantity %> × <%= number_to_currency(line.unit_price, unit: '€', format: '%n %u') %></td>
        <td class="num"><%= number_to_currency(line.subtotal, unit: '€', format: '%n %u') %></td>
      </tr>
    <% end %>
    <% if @order.shipping_cost.positive? %>
      <tr><td colspan="2">Transporte</td><td class="num"><%= number_to_currency(@order.shipping_cost, unit: '€', format: '%n %u') %></td></tr>
    <% end %>
    <tr class="total-row"><td colspan="2">Total</td><td class="num"><%= number_to_currency(@order.total, unit: '€', format: '%n %u') %></td></tr>
  </tbody>
</table>

<h2>Notas internas</h2>
<%= form_with model: @order, url: admin_order_path(@order), method: :patch, local: true, style: 'max-width: 620px;' do |f| %>
  <%= f.text_area :admin_notes, rows: 4, style: 'width:100%; font-family: inherit;', placeholder: 'Anotaciones visibles solo para el equipo (no se envían al cliente)…' %>
  <p><%= f.submit 'Guardar notas', class: 'btn btn-outline' %></p>
<% end %>

<h2>Histórico</h2>
<table class="table" style="max-width: 480px;">
  <tbody>
    <% @order.order_events.chronological.each do |event| %>
      <tr>
        <td><span class="badge <%= event.event %>"><%= event.event %></span></td>
        <td><%= l event.created_at, format: :short %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<p style="color: var(--muted); font-size: 13px;">Stripe: <%= @order.stripe_session_id.presence || '—' %></p>
