<h1>Pedidos</h1>

<% card = 'flex:1; min-width:150px; padding:14px 16px; background:var(--card-bg); border:1px solid var(--border); border-radius:var(--radius); text-decoration:none; color:inherit;' %>
<div style="display:flex; gap:12px; flex-wrap:wrap; margin: 12px 0 22px;">
  <%= link_to admin_orders_path(payment: 'pendiente'), style: card do %>
    <div style="font-size:24px; font-weight:700; color:#c0392b;"><%= @summary[:pending_payment] %></div>
    <div style="color:var(--muted); font-size:13px;">Pendientes de pago</div>
  <% end %>
  <%= link_to admin_orders_path(payment: 'pagado', status: 'creado'), style: card do %>
    <div style="font-size:24px; font-weight:700; color:var(--magenta);"><%= @summary[:to_ship] %></div>
    <div style="color:var(--muted); font-size:13px;">Pagados por enviar</div>
  <% end %>
  <div style="<%= card %>">
    <div style="font-size:24px; font-weight:700; color:#2e7d32;"><%= number_to_currency(@summary[:revenue], unit: '€', format: '%n %u') %></div>
    <div style="color:var(--muted); font-size:13px;">Ingresos cobrados</div>
  </div>
</div>

<div class="filter-tabs">
  <%= link_to "Todos (#{@counts.values.sum})", admin_orders_path(q: @query, payment: @payment), class: ('active' if @status.nil?) %>
  <% Order.statuses.keys.each do |status| %>
    <%= link_to "#{status.capitalize} (#{@counts[status] || 0})", admin_orders_path(status: status, q: @query, payment: @payment), class: ('active' if @status == status) %>
  <% end %>
</div>

<%= form_with url: admin_orders_path, method: :get, local: true, class: 'orders-search' do %>
  <input type="search" name="q" value="<%= @query %>" placeholder="Buscar por nº de pedido, nombre, email, teléfono, ciudad o país…" class="orders-search-input">
  <select name="status" class="orders-search-select">
    <option value="">Estado: todos</option>
    <% Order.statuses.keys.each do |status| %>
      <option value="<%= status %>" <%= 'selected' if @status == status %>><%= status.capitalize %></option>
    <% end %>
  </select>
  <select name="payment" class="orders-search-select">
    <option value="">Pago: todos</option>
    <% Order.payment_statuses.keys.each do |payment| %>
      <option value="<%= payment %>" <%= 'selected' if @payment == payment %>><%= payment.capitalize %></option>
    <% end %>
  </select>
  <button type="submit" class="btn btn-primary" style="padding: 8px 18px;">Filtrar</button>
  <% if @query.present? || @payment %>
    <%= link_to 'Limpiar', admin_orders_path(status: @status), class: 'btn btn-outline', style: 'padding: 8px 18px;' %>
  <% end %>
<% end %>

<% if @orders.empty? %>
  <p>No hay pedidos que coincidan<%= " en estado #{@status}" if @status %>.</p>
<% else %>
  <table class="table">
    <thead>
      <tr><th>Número</th><th>Fecha</th><th>Cliente</th><th>Idioma</th><th class="num">Total</th><th>Pago</th><th>Estado</th><th></th></tr>
    </thead>
    <tbody>
      <% @orders.each do |order| %>
        <tr>
          <td><%= link_to order.number, admin_order_path(order) %></td>
          <td><%= l order.created_at, format: :short %></td>
          <td><%= order.customer_name %></td>
          <td><%= { 'es' => '🇪🇸 ES', 'pt' => '🇵🇹 PT', 'en' => '🇬🇧 EN' }[order.locale] || order.locale.to_s.upcase %></td>
          <td class="num"><%= number_to_currency(order.total, unit: '€', format: '%n %u') %></td>
          <td><span class="badge <%= order.payment_status %>"><%= order.payment_status %></span></td>
          <td><span class="badge <%= order.status %>"><%= order.status %></span></td>
          <td>
            <% if order.next_status %>
              <%= button_to "Marcar #{order.next_status}", advance_admin_order_path(order), method: :patch,
                            class: 'btn btn-outline', style: 'padding: 5px 12px; font-size: 13px;',
                            form: { data: { turbo_confirm: "¿Marcar el pedido #{order.number} como #{order.next_status}?" } } %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<% if @pagy.pages > 1 %>
  <div class="pagy-nav-wrap"><%== pagy_nav(@pagy) %></div>
<% end %>
