<h1>Pedidos</h1>

<% card = 'flex:1; min-width:150px; padding:14px 16px; background:var(--card-bg); border:1px solid var(--border); border-radius:var(--radius); text-decoration:none; color:inherit;' %>
<div style="display:flex; gap:12px; flex-wrap:wrap; margin: 12px 0 22px;">
  <%= link_to admin_orders_path(payment: 'pendiente'), style: card do %>
    <div style="font-size:24px; font-weight:700; color:#c0392b;"><%= @summary[:pending_payment] %></div>
    <div style="color:var(--muted); font-size:13px;">Pendientes de pago</div>
  <% end %>
  <%= link_to admin_orders_path(stale: 1), style: card do %>
    <div style="font-size:24px; font-weight:700; color:#e67e22;"><%= @summary[:stale_unpaid] %></div>
    <div style="color:var(--muted); font-size:13px;">Sin pagar +<%= Order::STALE_UNPAID_DAYS %> días</div>
  <% end %>
  <%= link_to admin_orders_path(payment: 'pagado', status: 'creado'), style: card do %>
    <div style="font-size:24px; font-weight:700; color:var(--magenta);"><%= @summary[:to_ship] %></div>
    <div style="color:var(--muted); font-size:13px;">Pagados por enviar</div>
  <% end %>
  <div style="<%= card %>">
    <div style="font-size:24px; font-weight:700; color:#2e7d32;"><%= number_to_currency(@summary[:revenue], unit: '€', format: '%n %u') %></div>
    <div style="color:var(--muted); font-size:13px;">Ingresos cobrados</div>
  </div>
</div>

<div class="filter-tabs">
  <%= link_to "Todos (#{@counts.values.sum})", admin_orders_path(q: @query, payment: @payment), class: ('active' if @status.nil?) %>
  <% Order.statuses.keys.each do |status| %>
    <%= link_to "#{status.capitalize} (#{@counts[status] || 0})", admin_orders_path(status: status, q: @query, payment: @payment), class: ('active' if @status == status) %>
  <% end %>
</div>

<%= form_with url: admin_orders_path, method: :get, local: true, class: 'orders-search' do %>
  <input type="search" name="q" value="<%= @query %>" placeholder="Buscar por nº de pedido, nombre, email, teléfono, ciudad o país…" class="orders-search-input">
  <select name="status" class="orders-search-select">
    <option value="">Estado: todos</option>
    <% Order.statuses.keys.each do |status| %>
      <option value="<%= status %>" <%= 'selected' if @status == status %>><%= status.capitalize %></option>
    <% end %>
  </select>
  <select name="payment" class="orders-search-select">
    <option value="">Pago: todos</option>
    <% Order.payment_statuses.keys.each do |payment| %>
      <option value="<%= payment %>" <%= 'selected' if @payment == payment %>><%= payment.capitalize %></option>
    <% end %>
  </select>
  <label style="font-size:13px; color:var(--muted);">Desde <input type="date" name="from" value="<%= @from %>" class="orders-search-select"></label>
  <label style="font-size:13px; color:var(--muted);">Hasta <input type="date" name="to" value="<%= @to %>" class="orders-search-select"></label>
  <% if @stale %><input type="hidden" name="stale" value="1"><% end %>
  <button type="submit" class="btn btn-primary" style="padding: 8px 18px;">Filtrar</button>
  <%= link_to '⬇ CSV', admin_orders_path(status: @status, payment: @payment, q: @query, from: @from, to: @to, stale: @stale, format: :csv), class: 'btn btn-outline', style: 'padding: 8px 18px;' %>
  <% if @query.present? || @payment || @from || @to || @stale %>
    <%= link_to 'Limpiar', admin_orders_path(status: @status), class: 'btn btn-outline', style: 'padding: 8px 18px;' %>
  <% end %>
<% end %>

<% if @orders.empty? %>
  <p>No hay pedidos que coincidan<%= " en estado #{@status}" if @status %>.</p>
<% else %>
  <p style="text-align:right; font-size:13px; color:var(--muted); margin:0 0 8px;">
    Por página:
    <% [ 25, 50, 100 ].each do |n| %>
      <% if n == @per %>
        <strong><%= n %></strong>
      <% else %>
        <%= link_to n, request.query_parameters.merge(per: n, page: nil) %>
      <% end %>
    <% end %>
  </p>
  <%= form_with url: generate_invoices_admin_orders_path, method: :post, id: "generate-invoices-form",
                data: { turbo_confirm: "Se generará la factura de los pedidos marcados (simplificada, o completa si llevan datos fiscales). ¿Continuar?" },
                style: "display:flex; flex-wrap:wrap; align-items:center; gap:10px; margin:0 0 10px;" do %>
    <button type="submit" class="btn btn-primary" style="padding: 8px 16px;">🧾 Generar factura de las seleccionadas</button>
    <label style="font-size:13px; color:var(--muted); display:flex; align-items:center; gap:6px;">
      <input type="checkbox" id="check-all-orders"> Marcar todos
    </label>
    <span style="font-size:13px; color:var(--muted);">Solo pedidos <strong>pagados sin factura</strong>. Las ventas web salen como factura simplificada (completa si el cliente puso datos fiscales).</span>
  <% end %>

  <table class="table">
    <thead>
      <tr><th style="width:1%;"></th><th>Número</th><th>Fecha</th><th>Cliente</th><th>Idioma</th><th class="num">Total</th><th>Pago</th><th>Estado</th><th>Factura</th><th></th></tr>
    </thead>
    <tbody>
      <% @orders.each do |order| %>
        <% invoice = @invoices_by_order[order.id] %>
        <tr>
          <td>
            <% if invoice.nil? && order.pago_pagado? %>
              <%= check_box_tag "order_ids[]", order.id, false, form: "generate-invoices-form", class: "order-check" %>
            <% end %>
          </td>
          <td><%= link_to order.number, admin_order_path(order) %></td>
          <td><%= l order.created_at, format: :short %></td>
          <td><%= order.customer_name %></td>
          <td><%= { 'es' => '🇪🇸 ES', 'pt' => '🇵🇹 PT', 'en' => '🇬🇧 EN' }[order.locale] || order.locale.to_s.upcase %></td>
          <td class="num"><%= number_to_currency(order.total, unit: '€', format: '%n %u') %></td>
          <td><span class="badge <%= order.payment_status %>"><%= order.payment_status %></span></td>
          <td><span class="badge <%= order.status %>"><%= order.status %></span></td>
          <td>
            <% if invoice %>
              <%= link_to "🖨 #{invoice.number}", invoice_pdf_admin_accounting_path(invoice), target: "_blank", rel: "noopener",
                          style: "font-size:13px; white-space:nowrap;" %>
            <% elsif order.pago_pagado? %>
              <%= link_to "👁 Previsualizar", preview_admin_accounting_index_path(order_id: order.id), target: "_blank", rel: "noopener",
                          style: "font-size:13px; white-space:nowrap;", title: "Previsualizar la factura antes de emitir" %>
            <% else %>
              <span style="color:var(--muted);">—</span>
            <% end %>
          </td>
          <td>
            <% if order.next_status %>
              <%= button_to "Marcar #{order.next_status}", advance_admin_order_path(order), method: :patch,
                            class: 'btn btn-outline', style: 'padding: 5px 12px; font-size: 13px;',
                            form: { data: { turbo_confirm: "¿Marcar el pedido #{order.number} como #{order.next_status}?" } } %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <script>
    (function () {
      var all = document.getElementById("check-all-orders");
      if (!all) return;
      all.addEventListener("change", function () {
        document.querySelectorAll(".order-check").forEach(function (c) { c.checked = all.checked; });
      });
    })();
  </script>
<% end %>

<% if @pagy.pages > 1 %>
  <div class="pagy-nav-wrap"><%== @pagy.series_nav %></div>
<% end %>
