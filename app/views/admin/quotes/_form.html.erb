<% product_data = Product.ordered.includes(:price_tiers).each_with_object({}) do |p, h|
     tiers = p.price_tiers.map { |t| [ t.min_units, t.unit_price.to_f ] }
     tiers = [ [ 1, (p.price / (1 + (p.vat_percentage.to_d / 100))).round(4).to_f ] ] if tiers.empty?
     h[p.id] = { name: p.name, tiers: tiers, shipping_unit: p.shipping_unit_cost.to_f }
   end %>
<% shipping_rates = Order::EU_COUNTRIES.index_with { |country| ShippingRate.base_for(country).to_f } %>

<%= form_with model: [:admin, quote], local: true,
              data: { controller: 'quote-form', quote_form_products_value: product_data.to_json,
                      quote_form_rates_value: shipping_rates.to_json } do |f| %>
  <% if quote.errors.any? %>
    <div class="errors"><ul><% quote.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul></div>
  <% end %>

  <div class="form-grid" style="max-width: 860px;">
    <div>
      <%= f.label :client_id, 'Cliente *' %>
      <%= f.collection_select :client_id, Client.ordered, :id, :name, { include_blank: true }, { class: 'form-select', required: true } %>
      <p class="action-note" style="margin-top:4px;"><%= link_to '+ crear cliente nuevo', new_admin_client_path, target: '_blank', rel: 'noopener' %></p>
    </div>
    <div><%= f.label :issued_on, 'Fecha *' %><%= f.date_field :issued_on, required: true %></div>
    <div><%= f.label :internal_description, 'Descripción (para uso interno)' %><%= f.text_field :internal_description, placeholder: 'p. ej. 180 uds. curso 26/27' %></div>
    <div><%= f.label :valid_until, 'Válido hasta' %><%= f.date_field :valid_until %></div>
    <div><%= f.label :payment_terms, 'Condiciones de pago' %><%= f.text_field :payment_terms %></div>
    <div>
      <%= f.label :bank_account, 'Cuenta de cobro' %>
      <%= f.select :bank_account,
                   Quote::BANK_ACCOUNTS.map { |account| bank, iban = account.split(' ', 2); [ "#{iban} (#{bank})", account ] },
                   {}, { class: 'form-select' } %>
    </div>
    <div class="full"><%= f.label :delivery_terms, 'Plazo de entrega *' %><%= f.text_field :delivery_terms, required: true, placeholder: '1 de septiembre de 2026' %></div>
    <div class="full"><%= f.label :remarks, 'Observaciones (SÍ salen en el presupuesto)' %><%= f.text_area :remarks, rows: 2 %></div>
    <div class="full"><%= f.label :notes, 'Notas internas (no salen en el PDF)' %><%= f.text_area :notes, rows: 2 %></div>
  </div>

  <h2 style="margin-top:24px;">Líneas</h2>
  <p class="action-note" style="margin-top:0;">Al elegir producto y cambiar las unidades, el precio se rellena solo con el <strong>escalado</strong>; en el documento cada línea sale con el nombre del producto. Si tocas el precio a mano y no coincide con el escalado, verás un aviso — puedes dejarlo así a propósito. Los descuentos son opcionales: solo aparecen en el documento si los usas.</p>
  <table class="table" style="max-width: 1080px;">
    <thead><tr><th></th><th>Producto</th><th>Uds.</th><th>P. unitario (€ sin IVA)</th><th>Dto. %</th><th>IVA %</th><th class="num">Total línea</th><th></th></tr></thead>
    <tbody data-quote-form-target="linesBody">
      <%= f.fields_for :quote_lines do |lf| %>
        <%= render 'line_fields', lf: lf %>
      <% end %>
    </tbody>
    <tfoot>
      <%# El transporte es siempre la última línea: se recalcula solo con la
          config de Transporte al cambiar líneas o país, es editable a mano
          (con aviso) y no se puede quitar. %>
      <tr style="background: var(--card-bg);">
        <td></td>
        <td>
          <strong>Transporte</strong><br>
          <%= f.select :shipping_country, Order::EU_COUNTRIES, {}, { class: 'form-select', data: { quote_form_target: 'shippingCountry', action: 'change->quote-form#applyShipping' } } %>
        </td>
        <td style="text-align:center;">1</td>
        <td>
          <%= f.number_field :shipping_cost, step: 0.01, min: 0, style: 'width:120px;', data: { quote_form_target: 'shipping', action: 'input->quote-form#shippingEdited' } %>
          <span data-quote-form-target="shippingWarning" hidden class="field-warning"></span>
        </td>
        <td style="text-align:center; color:var(--muted);">—</td>
        <td><%= f.select :vat_rate, [ [ '21 %', 21 ], [ '0 %', 0 ] ], { selected: quote.vat_rate.to_i },
                         { class: 'form-select', style: 'min-width:90px;', data: { quote_form_target: 'shippingVat', action: 'change->quote-form#applyShipping' } } %></td>
        <td class="num"><span data-quote-form-target="shippingTotal">—</span></td>
        <td></td>
      </tr>
    </tfoot>
  </table>
  <template data-quote-form-target="template">
    <%= f.fields_for :quote_lines, QuoteLine.new, child_index: 'NEW_RECORD' do |lf| %>
      <%= render 'line_fields', lf: lf %>
    <% end %>
  </template>
  <p>
    <button type="button" class="btn btn-outline" data-action="quote-form#addLine">+ Añadir línea</button>
    <span style="margin-left: 18px;">
      <label for="quote_discount_percent" style="display:inline; font-weight:600; font-size:14px;">Descuento total del presupuesto (%):</label>
      <%= f.number_field :discount_percent, step: 0.1, min: 0, max: 100, style: 'width:85px;',
                         data: { quote_form_target: 'globalDiscount', action: 'input->quote-form#recalc' } %>
      <span class="action-note" style="margin:0;">(sobre las líneas, sin el transporte; solo sale en el PDF si es mayor que 0)</span>
    </span>
  </p>

  <div style="max-width:960px; margin:14px 0; padding:12px 16px; background:var(--card-bg); border:1px solid var(--border); border-radius:var(--radius); display:flex; gap:26px; flex-wrap:wrap; font-size:15px;">
    <span><strong>Total sin IVA:</strong> <span data-quote-form-target="totalNet">—</span></span>
    <span><strong>IVA:</strong> <span data-quote-form-target="totalVat">—</span></span>
    <span><strong>Total con IVA:</strong> <span data-quote-form-target="totalGross">—</span></span>
    <span class="action-note" style="margin:0;">(en vivo, transporte incluido)</span>
  </div>

  <p>
    <%= f.submit 'Guardar presupuesto', class: 'btn btn-primary' %>
    <button type="submit" name="preview" value="1" formtarget="_blank"
            data-turbo="false" class="btn btn-outline">👁 Previsualizar PDF</button>
    <%= link_to 'Cancelar', admin_quotes_path, class: 'btn btn-outline' %>
  </p>
<% end %>
