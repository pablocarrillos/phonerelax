<h1>Presupuestos</h1>
<p>
  <%= link_to '+ Nuevo presupuesto', new_admin_quote_path, class: 'btn btn-primary' %>
  <%= link_to "Clientes (#{Client.count})", admin_clients_path, class: 'btn btn-outline' %>
</p>

<% if @client_filter %>
  <p class="action-note" style="margin-top:0;">Mostrando solo los presupuestos de <strong><%= @client_filter.name %></strong> · <%= link_to 'ver todos', admin_quotes_path %></p>
<% end %>

<div class="action-row" style="margin: 0 0 16px; display:flex; gap:8px; flex-wrap:wrap;">
  <% chip = 'padding:5px 14px; font-size:14px;' %>
  <%= link_to "Todos (#{@status_counts.values.sum})", admin_quotes_path(client_id: @client_filter&.id),
              class: "btn #{@status_filter ? 'btn-outline' : 'btn-primary'}", style: chip %>
  <% Quote::STATUS_LABELS.each do |st, label| %>
    <%= link_to "#{label} (#{@status_counts[st].to_i})", admin_quotes_path(status: st, client_id: @client_filter&.id),
                class: "btn #{@status_filter == st ? 'btn-primary' : 'btn-outline'}", style: chip %>
  <% end %>
</div>

<% if @quotes.any? %>
  <table class="table">
    <thead><tr><th>Oferta Nº</th><th>Fecha</th><th>Cliente</th><th>Estado</th><th>Descripción (interna)</th><th class="num">Total (sin IVA)</th><th class="num">Total (con IVA)</th><th></th></tr></thead>
    <tbody>
      <% @quotes.each do |quote| %>
        <tr>
          <td><%= link_to quote.number, admin_quote_path(quote) %></td>
          <td><%= l quote.issued_on, format: '%d/%m/%Y' %></td>
          <td><%= quote.client.name %></td>
          <td>
            <span class="badge <%= quote.status %>"><%= quote.status_label %></span>
            <% unless quote.sin_pagos? %><br><span class="badge <%= quote.payment_status %>" style="margin-top:4px;"><%= quote.payment_status_label %></span><% end %>
          </td>
          <td style="color:var(--muted); font-size:14px;"><%= quote.internal_description.presence || '—' %></td>
          <td class="num"><%= number_to_currency(quote.subtotal, unit: '€', format: '%n %u') %></td>
          <td class="num"><strong><%= number_to_currency(quote.total, unit: '€', format: '%n %u') %></strong></td>
          <td style="text-align:right;"><%= link_to '🖨 PDF', print_admin_quote_path(quote), target: '_blank', rel: 'noopener' %></td>
        </tr>
      <% end %>
    </tbody>
    <% if @status_filter %>
      <tfoot>
        <tr class="total-row">
          <td colspan="5"><strong>Total «<%= Quote::STATUS_LABELS[@status_filter] %>» (<%= @quotes.size %>)</strong></td>
          <td class="num"><strong><%= number_to_currency(@quotes.sum(&:subtotal), unit: '€', format: "%n %u") %></strong></td>
          <td class="num"><strong><%= number_to_currency(@quotes.sum(&:total), unit: '€', format: "%n %u") %></strong></td>
          <td></td>
        </tr>
      </tfoot>
    <% end %>
  </table>
<% else %>
  <p class="action-note">Todavía no hay presupuestos<%= " en «#{Quote::STATUS_LABELS[@status_filter]}»" if @status_filter %>.</p>
<% end %>
