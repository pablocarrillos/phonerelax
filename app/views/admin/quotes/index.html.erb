<h1>Presupuestos</h1>
<p>
  <%= link_to '+ Nuevo presupuesto', new_admin_quote_path, class: 'btn btn-primary' %>
  <%= link_to "Clientes (#{Client.count})", admin_clients_path, class: 'btn btn-outline' %>
</p>

<% if @client_filter %>
  <p class="action-note" style="margin-top:0;">Mostrando solo los presupuestos de <strong><%= @client_filter.name %></strong> · <%= link_to 'ver todos', admin_quotes_path %></p>
<% end %>

<% chip = 'padding:5px 14px; font-size:14px;' %>
<% base = { client_id: @client_filter&.id, from: params[:from].presence, to: params[:to].presence,
             all_dates: (@all_dates ? 1 : nil) } %>
<div class="action-row" style="margin: 0 0 12px; display:flex; gap:8px; flex-wrap:wrap;">
  <%= link_to "Todos (#{@status_counts.values.sum})", admin_quotes_path(base),
              class: "btn #{@status_filter ? 'btn-outline' : 'btn-primary'}", style: chip %>
  <%= link_to "Vendidos (#{@sold_count})", admin_quotes_path(base.merge(status: 'vendidos')),
              class: "btn #{@status_filter == 'vendidos' ? 'btn-primary' : 'btn-outline'}", style: chip %>
  <% Quote::STATUS_LABELS.each do |st, label| %>
    <%= link_to "#{label} (#{@status_counts[st].to_i})", admin_quotes_path(base.merge(status: st)),
                class: "btn #{@status_filter == st ? 'btn-primary' : 'btn-outline'}", style: chip %>
  <% end %>
</div>

<%# Buscador global: textos del presupuesto y sus líneas, contacto, cliente y
    nombres de ficheros adjuntos. Busca en todos los años. %>
<%= form_with url: admin_quotes_path, method: :get, local: true,
              html: { style: 'margin: 0 0 12px; display:flex; gap:10px; align-items:center; flex-wrap:wrap;' } do %>
  <% if @client_filter %><%= hidden_field_tag :client_id, @client_filter.id %><% end %>
  <% if @status_filter %><%= hidden_field_tag :status, @status_filter %><% end %>
  <%= search_field_tag :q, @query, placeholder: 'Buscar en textos, contacto, cliente y ficheros…', class: 'input-compact', style: 'margin:0; width: 340px;' %>
  <button type="submit" class="btn btn-outline" style="<%= chip %>">Buscar</button>
  <% if @query.present? %>
    <span class="action-note" style="margin:0;"><%= @quotes.size %> resultado(s) de «<%= @query %>» en todos los años.</span>
    <%= link_to 'Quitar búsqueda', admin_quotes_path(client_id: @client_filter&.id, status: @status_filter), class: 'btn btn-danger-link' %>
  <% end %>
<% end %>

<%# Filtro de fechas en una sola fila: etiquetas al lado de cada campo. %>
<%= form_with url: admin_quotes_path, method: :get, local: true,
              html: { style: 'margin: 0 0 18px; display:flex; gap:10px; align-items:center; flex-wrap:wrap;' } do %>
  <% if @client_filter %><%= hidden_field_tag :client_id, @client_filter.id %><% end %>
  <% if @status_filter %><%= hidden_field_tag :status, @status_filter %><% end %>
  <% if @query.present? %><%= hidden_field_tag :q, @query %><% end %>
  <label for="from" style="font-size:14px; font-weight:600; color:var(--muted); margin:0;">Creados desde</label>
  <%= date_field_tag :from, (params[:from].presence || (@current_year_default ? @from : nil)), id: 'from', class: 'input-compact', style: 'margin:0;' %>
  <label for="to" style="font-size:14px; font-weight:600; color:var(--muted); margin:0;">hasta</label>
  <%= date_field_tag :to, params[:to], id: 'to', class: 'input-compact', style: 'margin:0;' %>
  <button type="submit" class="btn btn-outline" style="<%= chip %>">Filtrar fechas</button>
  <%# por defecto solo el año en curso; desde aquí se ven todos los años %>
  <% if @current_year_default %>
    <span class="action-note" style="margin:0;">Mostrando el año en curso (<%= Date.current.year %>).</span>
    <%= link_to 'Ver todos los años', admin_quotes_path(client_id: @client_filter&.id, status: @status_filter, all_dates: 1), class: 'btn btn-outline', style: chip %>
  <% elsif @from || @to %>
    <%= link_to 'Quitar fechas', admin_quotes_path(client_id: @client_filter&.id, status: @status_filter, all_dates: 1), class: 'btn btn-danger-link' %>
  <% else %>
    <span class="action-note" style="margin:0;">Mostrando todos los años.</span>
    <%= link_to "Solo #{Date.current.year}", admin_quotes_path(client_id: @client_filter&.id, status: @status_filter), class: 'btn btn-outline', style: chip %>
  <% end %>
<% end %>

<% show_delivery = %w[aprobado entregado vendidos].include?(@status_filter) %>
<% show_dtf = @status_filter == "aprobado" %>
<% if @quotes.any? %>
  <table class="table">
    <% label_cols = (show_delivery ? 6 : 5) + (show_dtf ? 1 : 0) %>
    <thead>
      <tr><th>Oferta Nº</th><th>Fecha</th><th>Cliente</th><th>Estado</th><th>Descripción (interna)</th><% if show_delivery %><th>Plazo de entrega</th><% end %><% if show_dtf %><th>DTF</th><% end %><th class="num">Total (sin IVA)</th><th class="num">Total (con IVA)</th><th></th></tr>
      <%# totales de lo que se está mostrando, siempre a la vista %>
      <tr class="total-row">
        <th colspan="<%= label_cols %>" style="text-align:right;">Totales<%= " «#{status_filter_label}»" if @status_filter %> · <%= @quotes.size %> <%= "presupuesto".pluralize(@quotes.size) %></th>
        <th class="num"><%= number_to_currency(@quotes.sum(&:subtotal), unit: '€', format: '%n %u') %></th>
        <th class="num"><%= number_to_currency(@quotes.sum(&:total), unit: '€', format: '%n %u') %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @quotes.each do |quote| %>
        <tr>
          <td><%= link_to quote.number, admin_quote_path(quote) %></td>
          <td><%= l quote.issued_on, format: '%d/%m/%Y' %></td>
          <td><%= quote.client.name %></td>
          <td>
            <span class="badge <%= quote.status %>"><%= quote.status_label %></span>
            <% unless quote.sin_pagos? %><br><span class="badge <%= quote.payment_status %>" style="margin-top:4px;"><%= quote.payment_status_label %></span><% end %>
          </td>
          <td style="color:var(--muted); font-size:14px;"><%= quote.internal_description.presence || '—' %></td>
          <% if show_delivery %><td style="font-size:14px;"><%= quote.delivery_terms.presence || '—' %></td><% end %>
          <% if show_dtf %>
            <td>
              <% if quote.dtf_lines? %>
                <span class="badge dtf">DTF</span>
                <br><span class="badge <%= quote.dtf_file.attached? ? 'dtf_fichero_ok' : 'dtf_fichero_falta' %>" style="margin-top:4px;"><%= quote.dtf_file.attached? ? 'Fichero ✓' : 'Sin fichero' %></span>
              <% elsif quote.dtf_file.attached? %>
                <span class="badge dtf_fichero_ok" title="Tiene Fichero DTF aunque ninguna línea lleva personalización DTF">Fichero ✓</span>
              <% else %>
                <span style="color:var(--muted);">—</span>
              <% end %>
            </td>
          <% end %>
          <td class="num"><%= number_to_currency(quote.subtotal, unit: '€', format: '%n %u') %></td>
          <td class="num"><strong><%= number_to_currency(quote.total, unit: '€', format: '%n %u') %></strong></td>
          <td style="text-align:right;"><%= link_to '🖨 PDF', print_admin_quote_path(quote), target: '_blank', rel: 'noopener' %></td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr class="total-row">
        <td colspan="<%= label_cols %>" style="text-align:right;"><strong>Totales<%= " «#{status_filter_label}»" if @status_filter %> (<%= @quotes.size %>)</strong></td>
        <td class="num"><strong><%= number_to_currency(@quotes.sum(&:subtotal), unit: '€', format: '%n %u') %></strong></td>
        <td class="num"><strong><%= number_to_currency(@quotes.sum(&:total), unit: '€', format: '%n %u') %></strong></td>
        <td></td>
      </tr>
    </tfoot>
  </table>

  <% if @status_filter && @line_totals.any? %>
    <h2 style="margin-top: 30px;">Líneas de venta («<%= status_filter_label %>»)</h2>
    <p class="action-note" style="margin-top:0;">Todas las líneas de los presupuestos mostrados, agrupadas por producto (sin transporte).</p>
    <table class="table" style="max-width: 640px;">
      <thead><tr><th>Producto</th><th class="num">Unidades</th><th class="num">Total (sin IVA)</th></tr></thead>
      <tbody>
        <% @line_totals.each do |row| %>
          <tr>
            <td><%= row[:name] %></td>
            <td class="num"><%= row[:units] %></td>
            <td class="num"><%= number_to_currency(row[:total], unit: '€', format: "%n %u") %></td>
          </tr>
        <% end %>
        <tr class="total-row">
          <td><strong>Total líneas</strong></td>
          <td class="num"><strong><%= @line_totals.sum { |row| row[:units] } %></strong></td>
          <td class="num"><strong><%= number_to_currency(@line_totals.sum { |row| row[:total] }, unit: '€', format: "%n %u") %></strong></td>
        </tr>
<%# Puente: estas líneas + transporte (− descuento) cuadran con el «Total» de arriba. %>
<% bridge_disc = @quotes.sum(&:discount_amount) %>
<% bridge_ship = @quotes.sum(&:shipping_cost) %>
<% if bridge_disc.positive? %>
  <tr><td colspan="2" style="text-align:right; color:var(--muted); border:0;">− Descuento global</td><td class="num" style="color:var(--muted); border:0;">−<%= number_to_currency(bridge_disc, unit: '€', format: "%n %u") %></td></tr>
<% end %>
<tr><td colspan="2" style="text-align:right; color:var(--muted); border:0;">+ Transporte</td><td class="num" style="color:var(--muted); border:0;"><%= number_to_currency(bridge_ship, unit: '€', format: "%n %u") %></td></tr>
<tr class="total-row"><td colspan="2" style="text-align:right;"><strong>= Total «<%= status_filter_label %>» (sin IVA)</strong></td><td class="num"><strong><%= number_to_currency(@quotes.sum(&:subtotal), unit: '€', format: "%n %u") %></strong></td></tr>
      </tbody>
    </table>
  <% end %>
<% else %>
  <p class="action-note">Todavía no hay presupuestos<%= " en «#{status_filter_label}»" if @status_filter %>.</p>
<% end %>
