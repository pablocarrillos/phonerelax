<p><%= link_to '← Volver a presupuestos', admin_quotes_path %></p>
<h1>Presupuesto <%= @quote.number %></h1>

<div class="order-actions">
  <p class="order-badges">
    <strong>Estado:</strong> <span class="badge <%= @quote.status %>"><%= @quote.status_label %></span>
    <% unless @quote.sin_pagos? %><span class="badge <%= @quote.payment_status %>"><%= @quote.payment_status_label %></span><% end %>
    &nbsp;&nbsp;<strong>Cliente:</strong> <%= @quote.client.name %>
    &nbsp;&nbsp;<strong>Fecha:</strong> <%= l @quote.issued_on, format: '%d/%m/%Y' %>
    <% if @quote.valid_until %>&nbsp;&nbsp;<strong>Válido hasta:</strong> <%= l @quote.valid_until, format: '%d/%m/%Y' %><% end %>
  </p>
  <div class="action-section">
    <span class="action-title">Estado del presupuesto</span>
    <div class="action-row">
      <% buttons = { 'aprobado' => '✅ Aprobado', 'en_pausa' => '⏸ En pausa', 'perdido' => '✖ Perdido', 'abierto' => '↺ Reabrir' } %>
      <%# «Entregado» solo tiene sentido tras aprobar el pedido. %>
      <% buttons = { 'entregado' => '📦 Entregado' }.merge(buttons) if @quote.confirmed? %>
      <% buttons.each do |st, label| %>
        <% next if @quote.status == st %>
        <%= button_to label, set_status_admin_quote_path(@quote, status: st), method: :patch, class: 'btn btn-outline',
                      form: { style: 'display:inline-block', data: { turbo_confirm: "¿Pasar el presupuesto #{@quote.number} a «#{Quote::STATUS_LABELS[st]}»?" } } %>
      <% end %>
    </div>
  </div>
  <% if @quote.confirmed? %>
    <div class="action-section">
      <span class="action-title">Cobro</span>
      <div class="action-row">
        <% { 'pagado_confirmar' => '💶 Pagado para confirmar', 'pagado_total' => '💶 Pagado totalmente', 'sin_pagos' => '↺ Sin pagos' }.each do |st, label| %>
          <% next if @quote.payment_status == st %>
          <%= button_to label, set_payment_admin_quote_path(@quote, payment_status: st), method: :patch, class: 'btn btn-outline', form: { style: 'display:inline-block' } %>
        <% end %>
      </div>
    </div>
  <% end %>
  <div class="action-section">
    <div class="action-row">
      <%= link_to '🖨 Imprimir / PDF', print_admin_quote_path(@quote), target: '_blank', rel: 'noopener', class: 'btn btn-primary' %>
      <%= link_to 'Editar', edit_admin_quote_path(@quote), class: 'btn btn-outline' %>
      <%= button_to '⧉ Duplicar', duplicate_admin_quote_path(@quote), method: :post, class: 'btn btn-outline',
                    form: { data: { turbo_confirm: "¿Crear un presupuesto nuevo partiendo de #{@quote.number}? Tendrá número y fechas nuevos." } } %>
      <%= button_to '🗑 Borrar', admin_quote_path(@quote), method: :delete, class: 'btn btn-danger',
                    form: { data: { turbo_confirm: "¿Borrar el presupuesto #{@quote.number}?" } } %>
    </div>
  </div>
</div>

<% any_files = Quote::ATTACHMENTS.keys.any? { |name| @quote.order_file(name).attached? } %>
<% if @quote.confirmed? || any_files %>
  <h2 style="margin-top: 28px;">Ficheros del pedido</h2>
  <% unless @quote.confirmed? %>
    <p class="action-note" style="margin-top:0;">El presupuesto ya no está aprobado: los ficheros se conservan, pero no se pueden subir nuevos.</p>
  <% end %>
  <table class="table" style="max-width: 900px;">
    <thead><tr><th>Fichero</th><th>Actual</th><th style="text-align:right;">Acciones</th></tr></thead>
    <tbody>
      <% accepts = { "approved_sample" => "image/*", "signed_quote" => "application/pdf,.pdf" } %>
      <% @quote.available_files.each do |name| %>
        <% label = Quote::ATTACHMENTS[name] %>
        <% attachment = @quote.order_file(name) %>
        <tr>
          <td><strong><%= label %></strong></td>
          <td>
            <% if attachment.attached? %>
              <% if attachment.blob.content_type.to_s.start_with?("image/") %>
                <a href="<%= rails_blob_path(attachment) %>" target="_blank" rel="noopener"><img src="<%= rails_blob_path(attachment) %>" alt="<%= label %>" style="height: 42px; border-radius: 4px; vertical-align: middle; margin-right: 6px;"></a>
              <% end %>
              <%= link_to attachment.filename, rails_blob_path(attachment, disposition: 'attachment') %>
              <span class="action-note">(<%= number_to_human_size(attachment.blob.byte_size) %> · <%= l attachment.blob.created_at, format: :short %>)</span>
            <% else %>
              <span style="color:var(--muted);">—</span>
            <% end %>
          </td>
          <td style="text-align:right; white-space:nowrap;">
            <% viewable = attachment.attached? &&
                 (attachment.blob.content_type.to_s.start_with?("image/") || attachment.blob.content_type == "application/pdf") %>
            <% if viewable %>
              <%= link_to 'Ver', rails_blob_path(attachment), target: '_blank', rel: 'noopener',
                          class: 'btn btn-outline', style: 'padding: 5px 12px; font-size: 13px;' %>
            <% end %>
            <% if @quote.confirmed? %>
              <%= form_with url: upload_files_admin_quote_path(@quote), method: :patch, multipart: true, html: { style: 'display:inline-block;' } do %>
                <input type="file" name="quote[<%= name %>]" required style="max-width: 230px;"<% if accepts[name] %> accept="<%= accepts[name] %>"<% end %>>
                <button type="submit" class="btn btn-outline" style="padding: 5px 12px; font-size: 13px;"><%= attachment.attached? ? 'Reemplazar' : 'Subir' %></button>
              <% end %>
            <% end %>
            <% if attachment.attached? %>
              <%= button_to 'Borrar', purge_file_admin_quote_path(@quote, attachment: name), method: :delete, class: 'btn btn-danger',
                            form: { style: 'display:inline-block;', data: { turbo_confirm: "¿Borrar «#{label}» del presupuesto #{@quote.number}?" } },
                            style: 'padding: 5px 12px; font-size: 13px;' %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<% if @quote.samples.any? %>
  <p class="action-note" style="max-width:900px;">🧪 <strong>Muestras vinculadas (<%= @quote.samples.size %>):</strong>
    <%= safe_join(@quote.samples.recent_first.map { |s| link_to("#{s.organization} · #{s.sent_on ? l(s.sent_on, format: '%d/%m/%Y') : 's/f'}", edit_admin_sample_path(s)) }, ' · ') %></p>
<% end %>

<% with_discounts = @quote.line_discounts? %>
<% span = with_discounts ? 5 : 4 %>
<table class="table" style="max-width: 900px;">
  <thead><tr><th>Producto</th><th class="num">IVA</th><th class="num">P. Uni.</th><% if with_discounts %><th class="num">Dto.</th><% end %><th class="num">Ud.</th><th class="num">Total</th></tr></thead>
  <tbody>
    <% @quote.quote_lines.each do |line| %>
      <tr>
        <td><%= line.description %></td>
        <td class="num"><%= number_to_percentage(line.vat_rate, precision: 0) %></td>
        <td class="num"><%= number_with_precision(line.unit_price, precision: 2) %></td>
        <% if with_discounts %><td class="num"><%= line.discounted? ? number_to_percentage(line.discount_percent, precision: 0) : '—' %></td><% end %>
        <td class="num"><%= line.quantity %></td>
        <td class="num"><%= number_with_precision(line.total, precision: 2) %></td>
      </tr>
    <% end %>
    <% if @quote.discount_percent.to_d.positive? %>
      <tr>
        <td><strong>Descuento <%= number_to_percentage(@quote.discount_percent, precision: 0) %></strong></td>
        <td class="num" colspan="<%= span - 1 %>"></td>
        <td class="num">−<%= number_with_precision(@quote.discount_amount, precision: 2) %></td>
      </tr>
    <% end %>
    <tr>
      <td>Transporte</td>
      <td class="num"><%= number_to_percentage(@quote.vat_rate, precision: 0) %></td>
      <td class="num"><%= number_with_precision(@quote.shipping_cost, precision: 2) %></td>
      <% if with_discounts %><td class="num"></td><% end %>
      <td class="num">1</td>
      <td class="num"><%= number_with_precision(@quote.shipping_cost, precision: 2) %></td>
    </tr>
    <tr><td colspan="<%= span %>" style="text-align:right;"><strong>Total Oferta</strong></td><td class="num"><strong><%= number_to_currency(@quote.subtotal, unit: '€', format: '%n %u') %></strong></td></tr>
    <tr><td colspan="<%= span %>" style="text-align:right;">Importe IVA</td><td class="num"><%= number_to_currency(@quote.vat_amount, unit: '€', format: '%n %u') %></td></tr>
    <tr class="total-row"><td colspan="<%= span %>" style="text-align:right;">Total Euros</td><td class="num"><%= number_to_currency(@quote.total, unit: '€', format: '%n %u') %></td></tr>
  </tbody>
</table>

<p>
  <% if @quote.payment_terms.present? %><strong>Condiciones de pago:</strong> <%= @quote.payment_terms %><br><% end %>
  <% if @quote.delivery_terms.present? %><strong>Plazo de entrega:</strong> <%= @quote.delivery_terms %><% end %>
</p>
<% if @quote.notes.present? %>
  <h2>Notas internas</h2>
  <p><%= simple_format(@quote.notes) %></p>
<% end %>
