<h1>Solicitudes de presupuesto</h1>

<% if @quote_requests.empty? %>
  <p>No hay solicitudes de presupuesto todavía.</p>
<% else %>
  <table class="table">
    <thead>
      <tr><th>Fecha</th><th>Organización</th><th>Contacto</th><th>Sector</th><th class="num">Uds.</th><th>Mensaje</th><th></th></tr>
    </thead>
    <tbody>
      <% @quote_requests.each do |q| %>
        <tr>
          <td><%= l q.created_at, format: :short %></td>
          <td><strong><%= q.organization %></strong></td>
          <td>
            <%= q.name %><br>
            <%= mail_to q.email %><br>
            <%= q.phone.presence || '—' %>
          </td>
          <td><%= q.sector.presence&.capitalize || '—' %></td>
          <td class="num"><%= q.units || '—' %></td>
          <td style="max-width:320px; font-size:13px;"><%= simple_format(q.message) %></td>
          <td>
            <%= button_to 'Borrar', admin_quote_request_path(q), method: :delete,
                          class: 'btn-danger-link', form: { data: { turbo_confirm: '¿Borrar esta solicitud?' } } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
