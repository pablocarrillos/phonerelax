<%= form_with model: [:admin, product], local: true, data: { controller: 'pack-form' } do |f| %>
  <% if product.errors.any? %>
    <div class="errors"><ul><% product.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul></div>
  <% end %>
  <div class="form-grid" style="max-width: 860px;">
    <div>
      <%= f.label :price, 'Precio (€, IVA incluido)' %>
      <%= f.number_field :price, step: 0.01, data: { pack_form_target: 'price' } %>
      <p class="action-note" style="margin-top:4px;" data-pack-form-target="priceNote" hidden>Automático: se calcula con los precios de los componentes del pack.</p>
    </div>
    <div>
      <%= f.label :stock, 'Stock (unidades restantes)' %>
      <%= f.number_field :stock, min: 0, value: (product.pack? ? product.available_stock : product.stock),
                         data: { pack_form_target: 'stock' } %>
      <p class="action-note" style="margin-top:4px;" data-pack-form-target="stockNote" hidden>Automático: máximo de packs que permite el stock restante de los componentes.</p>
    </div>
    <div><%= f.label :vat_percentage, 'IVA (%)' %><%= f.number_field :vat_percentage, step: 0.1, min: 0 %></div>
    <div class="full"><label><%= f.check_box :active %> Activo (visible en la tienda)</label></div>
    <div class="full"><label><%= f.check_box :auto_carousel %> Mostrar la galería como carrusel automático (sin miniaturas, cambia sola cada 3&nbsp;s)</label></div>
    <div class="full"><label><%= f.check_box :pack, data: { pack_form_target: 'pack', action: 'change->pack-form#refresh' } %> Es un pack (su precio y su stock se calculan a partir de los componentes de abajo; se ignoran el precio, el escalado y el stock propios de este producto)</label></div>

    <div class="full">
      <%= f.label :cover_image, 'Imagen de portada' %>
      <div class="cover-field">
        <% if product.cover_url.present? %>
          <img src="<%= product.cover_url %>" alt="Portada actual" class="cover-preview">
        <% end %>
        <div>
          <%= f.file_field :cover_image, accept: 'image/*' %>
          <p class="help-block" style="color: var(--muted); font-size: 13px; margin: 6px 0 0;">Sube una imagen para sustituir la portada actual.</p>
        </div>
      </div>
    </div>

    <div class="full lang-tabs" data-controller="tabs">
      <div class="tab-buttons" role="tablist">
        <button type="button" class="tab-button active" data-tabs-target="tab" data-action="tabs#select">🇪🇸 Español</button>
        <button type="button" class="tab-button" data-tabs-target="tab" data-action="tabs#select">🇵🇹 Portugués</button>
        <button type="button" class="tab-button" data-tabs-target="tab" data-action="tabs#select">🇬🇧 Inglés</button>
        <button type="button" class="tab-button" data-tabs-target="tab" data-action="tabs#select">🇫🇷 Francés</button>
        <button type="button" class="tab-button" data-tabs-target="tab" data-action="tabs#select">🇩🇪 Alemán</button>
      </div>

      <div class="tab-panel" data-tabs-target="panel">
        <div><%= f.label :name, 'Nombre' %><%= f.text_field :name %></div>
        <div>
          <%= f.label :description, 'Descripción' %>
          <%= f.hidden_field :description, id: 'product_description' %>
          <trix-editor input="product_description" class="trix-content"></trix-editor>
        </div>
      </div>

      <div class="tab-panel" data-tabs-target="panel" hidden>
        <p class="help-block" style="color: var(--muted); font-size: 13px; margin-top: 0;">Si lo dejas vacío, en /pt se mostrará el contenido en español.</p>
        <div><%= f.label :name_pt, 'Nombre (PT)' %><%= f.text_field :name_pt %></div>
        <div>
          <%= f.label :description_pt, 'Descripción (PT)' %>
          <%= f.hidden_field :description_pt, id: 'product_description_pt' %>
          <trix-editor input="product_description_pt" class="trix-content"></trix-editor>
        </div>
      </div>

      <div class="tab-panel" data-tabs-target="panel" hidden>
        <p class="help-block" style="color: var(--muted); font-size: 13px; margin-top: 0;">Si lo dejas vacío, en /en se mostrará el contenido en español.</p>
        <div><%= f.label :name_en, 'Nombre (EN)' %><%= f.text_field :name_en %></div>
        <div>
          <%= f.label :description_en, 'Descripción (EN)' %>
          <%= f.hidden_field :description_en, id: 'product_description_en' %>
          <trix-editor input="product_description_en" class="trix-content"></trix-editor>
        </div>
      </div>

      <div class="tab-panel" data-tabs-target="panel" hidden>
        <p class="help-block" style="color: var(--muted); font-size: 13px; margin-top: 0;">Si lo dejas vacío, en /fr se mostrará el contenido en español.</p>
        <div><%= f.label :name_fr, 'Nombre (FR)' %><%= f.text_field :name_fr %></div>
        <div>
          <%= f.label :description_fr, 'Descripción (FR)' %>
          <%= f.hidden_field :description_fr, id: 'product_description_fr' %>
          <trix-editor input="product_description_fr" class="trix-content"></trix-editor>
        </div>
      </div>

      <div class="tab-panel" data-tabs-target="panel" hidden>
        <p class="help-block" style="color: var(--muted); font-size: 13px; margin-top: 0;">Si lo dejas vacío, en /de se mostrará el contenido en español.</p>
        <div><%= f.label :name_de, 'Nombre (DE)' %><%= f.text_field :name_de %></div>
        <div>
          <%= f.label :description_de, 'Descripción (DE)' %>
          <%= f.hidden_field :description_de, id: 'product_description_de' %>
          <trix-editor input="product_description_de" class="trix-content"></trix-editor>
        </div>
      </div>
    </div>
  </div>
  <div style="max-width: 860px; margin-top: 26px;" data-controller="price-tiers"
       data-price-tiers-rate-value="<%= product.vat_percentage || 21 %>" data-pack-form-target="tiers">
    <h2>Escalado de precios por cantidad</h2>
    <p class="action-note" style="margin-top:0;">Precio unitario a partir de cada tramo de unidades. Se aplica en la <strong>tienda</strong> (carrito y pedidos) y en los <strong>presupuestos</strong>. Los tres valores están sincronizados: al editar uno se recalculan los otros (descuento respecto al primer tramo). Sin tramos, se usa siempre el precio normal.</p>
    <table class="table" style="max-width:620px;">
      <thead><tr><th>Desde (uds.)</th><th class="num">€/ud. sin IVA</th><th class="num">€/ud. con IVA</th><th class="num">Dto. %</th><th>Quitar</th></tr></thead>
      <tbody data-price-tiers-target="tbody">
        <% factor = 1 + ((product.vat_percentage || 21).to_d / 100) %>
        <% base_price = product.price_tiers.reject(&:new_record?).min_by(&:min_units)&.unit_price %>
        <%= f.fields_for :price_tiers do |tf| %>
          <% tier = tf.object %>
          <tr data-price-tiers-target="row">
            <td><%= tf.number_field :min_units, min: 1, class: "input-compact", style: 'width:100px;', placeholder: ('nuevo tramo' if tier.new_record?) %></td>
            <td class="num"><%= tf.number_field :unit_price, step: 0.0001, min: 0, class: "input-compact", style: 'width:110px; text-align:right;',
                                                placeholder: ('sin IVA' if tier.new_record?), data: { role: 'net', action: 'input->price-tiers#fromNet' } %></td>
            <td class="num">
              <input type="number" step="0.01" min="0" class="input-compact" style="width:100px; text-align:right;"
                     value="<%= number_with_precision(tier.unit_price * factor, precision: 2, separator: '.') if tier.unit_price.present? %>"
                     placeholder="con IVA" data-role="gross" data-action="input->price-tiers#fromGross">
            </td>
            <td class="num">
              <% if !tier.new_record? && tier.unit_price == base_price %>
                <span style="color:var(--muted);">base</span>
              <% else %>
                <input type="number" step="0.1" class="input-compact" style="width:80px; text-align:right;"
                       value="<%= number_with_precision(100 * (1 - (tier.unit_price / base_price)), precision: 1, separator: '.') if tier.unit_price.present? && base_price&.positive? %>"
                       placeholder="dto. %" data-role="discount" data-action="input->price-tiers#fromDiscount">
              <% end %>
            </td>
            <td style="text-align:center;"><%= tf.check_box :_destroy if tier.persisted? %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <template data-price-tiers-target="template">
      <%= f.fields_for :price_tiers, PriceTier.new, child_index: 'NEW_RECORD' do |tf| %>
        <tr data-price-tiers-target="row">
          <td><%= tf.number_field :min_units, min: 1, class: "input-compact", style: 'width:100px;', placeholder: 'nuevo tramo' %></td>
          <td class="num"><%= tf.number_field :unit_price, step: 0.0001, min: 0, class: "input-compact", style: 'width:110px; text-align:right;',
                                              placeholder: 'sin IVA', data: { role: 'net', action: 'input->price-tiers#fromNet' } %></td>
          <td class="num">
            <input type="number" step="0.01" min="0" class="input-compact" style="width:100px; text-align:right;"
                   placeholder="con IVA" data-role="gross" data-action="input->price-tiers#fromGross">
          </td>
          <td class="num">
            <input type="number" step="0.1" class="input-compact" style="width:80px; text-align:right;"
                   placeholder="dto. %" data-role="discount" data-action="input->price-tiers#fromDiscount">
          </td>
          <td></td>
        </tr>
      <% end %>
    </template>
    <p style="margin-top:10px;"><button type="button" class="btn btn-outline" data-action="price-tiers#addRow">+ Añadir tramo</button></p>
  </div>

  <div style="max-width: 860px; margin-top: 26px;">
    <h2>Componentes del pack</h2>
    <p class="action-note" style="margin-top:0;">Solo aplica si marcas «Es un pack». Elige los productos y cuántas unidades incluye el pack. El precio se calcula con el <strong>escalado de cada componente</strong> para esa cantidad, y el stock disponible del pack depende del stock de sus componentes.</p>
    <table class="table" style="max-width:620px;">
      <thead><tr><th>Producto</th><th class="num">Unidades</th><th>Quitar</th></tr></thead>
      <tbody>
        <%= f.fields_for :pack_items do |pf| %>
          <tr>
            <td><%= pf.collection_select :component_id, Product.singles.where.not(id: product.id).ordered, :id, :name, { include_blank: true }, { class: 'form-select' } %></td>
            <td class="num"><%= pf.number_field :quantity, min: 1, class: 'input-compact', style: 'width:100px; text-align:right;' %></td>
            <td style="text-align:center;"><%= pf.check_box :_destroy if pf.object.persisted? %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <p><%= f.submit 'Guardar producto', class: 'btn btn-primary' %> <%= link_to 'Cancelar', admin_products_path, class: 'btn btn-outline' %></p>
<% end %>

<% if product.persisted? %>
  <h2>Imágenes de la galería</h2>
  <div class="admin-images">
    <% product.product_images.each do |image| %>
      <div class="admin-image">
        <img src="<%= image.src %>" alt="">
        <div class="admin-image-actions">
          <%= button_to '←', move_admin_product_product_image_path(product, image, direction: 'up'), method: :patch, class: 'btn btn-outline btn-move', title: 'Mover antes' %>
          <%= button_to 'Quitar', admin_product_product_image_path(product, image), method: :delete,
                        class: 'btn-danger-link', form: { data: { turbo_confirm: '¿Quitar esta imagen?' } } %>
          <%= button_to '→', move_admin_product_product_image_path(product, image, direction: 'down'), method: :patch, class: 'btn btn-outline btn-move', title: 'Mover después' %>
        </div>
      </div>
    <% end %>
  </div>
  <%= form_with url: admin_product_product_images_path(product), method: :post, local: true, multipart: true, class: 'add-image-form' do %>
    <input type="file" name="files[]" accept="image/*" multiple required>
    <button type="submit" class="btn btn-outline">Añadir imágenes</button>
  <% end %>
  <p class="action-note">Puedes seleccionar varias a la vez; se añaden al final (reordénalas con las flechas).</p>
<% else %>
  <p class="help-block" style="color: var(--muted);">Guarda el producto para poder gestionar su galería de imágenes.</p>
<% end %>
