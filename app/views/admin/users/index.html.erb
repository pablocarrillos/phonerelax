<h1>Administradores</h1>
<p><%= link_to 'Nuevo administrador', new_admin_user_path, class: 'btn btn-primary' %></p>
<table class="table" style="max-width: 720px;">
  <thead><tr><th>Nombre</th><th>Email</th><th>Alta</th><th></th></tr></thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.name.presence || '—' %><%= ' (tú)' if user == Current.user %></td>
        <td><%= user.email_address %></td>
        <td><%= l user.created_at, format: :short %></td>
        <td>
          <%= link_to 'Editar', edit_admin_user_path(user), class: 'btn btn-outline', style: 'padding: 5px 12px; font-size: 13px;' %>
          <% if user != Current.user %>
            <%= button_to 'Borrar', admin_user_path(user), method: :delete, class: 'btn-danger-link',
                          form: { style: 'display:inline;', data: { turbo_confirm: "¿Borrar al administrador #{user.email_address}?" } } %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
