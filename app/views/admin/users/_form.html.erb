<%= form_with model: [:admin, user], local: true do |f| %>
  <% if user.errors.any? %>
    <div class="errors"><ul><% user.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul></div>
  <% end %>
  <div class="form-grid" style="max-width: 560px;">
    <div class="full"><%= f.label :name, 'Nombre' %><%= f.text_field :name %></div>
    <div class="full"><%= f.label :email_address, 'Email' %><%= f.email_field :email_address %></div>
    <div class="full">
      <%= f.label :password, user.persisted? ? 'Contraseña nueva (vacío = mantener la actual)' : 'Contraseña' %>
      <%= f.password_field :password, autocomplete: 'new-password' %>
    </div>
    <div class="full">
      <%= f.label :password_confirmation, 'Repite la contraseña' %>
      <%= f.password_field :password_confirmation, autocomplete: 'new-password' %>
    </div>
  </div>
  <p><%= f.submit user.persisted? ? 'Guardar' : 'Crear administrador', class: 'btn btn-primary' %> <%= link_to 'Cancelar', admin_users_path, class: 'btn btn-outline' %></p>
<% end %>
