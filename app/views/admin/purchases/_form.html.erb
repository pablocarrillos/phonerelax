<%= form_with model: [:admin, purchase], local: true,
              data: { controller: 'purchase-form',
                      purchase_form_rate_value: (purchase.exchange_rate if purchase.usd?) } do |f| %>
  <% if purchase.errors.any? %>
    <div class="errors"><ul><% purchase.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul></div>
  <% end %>

  <div class="form-grid" style="max-width: 860px;">
    <div>
      <%= f.label :supplier_id, 'Proveedor *' %>
      <%= f.collection_select :supplier_id, Supplier.ordered, :id, :name, { include_blank: true }, { class: 'form-select', required: true } %>
    </div>
    <div><%= f.label :ordered_on, 'Fecha de compra *' %><%= f.date_field :ordered_on, required: true %></div>
    <div>
      <%= f.label :expected_on, 'Fecha de entrega (prevista)' %>
      <%= f.date_field :expected_on %>
    </div>
    <div><%= f.label :reference, 'Referencia (nº de factura, pedido…)' %><%= f.text_field :reference %></div>
    <div>
      <%= f.label :currency, 'Moneda' %>
      <%= f.select :currency, [['Euro (€)', 'EUR'], ['Dólar ($)', 'USD']], {}, { class: 'form-select', data: { purchase_form_target: 'currency', action: 'change->purchase-form#recalc' } } %>
    </div>
    <div>
      <%= f.label :invoice_date, 'Fecha de la factura' %>
      <%= f.date_field :invoice_date %>
      <p class="action-note" style="margin-top:4px;">Si la compra es en dólares, al guardar se fija automáticamente el tipo de cambio USD→€ de esta fecha.</p>
      <% if purchase.usd? && purchase.exchange_rate.present? %>
        <p class="action-note" style="margin-top:4px;">Tipo de cambio aplicado: <strong>1&nbsp;$ = <%= number_with_precision(purchase.exchange_rate, precision: 4) %>&nbsp;€</strong></p>
      <% end %>
    </div>
    <div>
      <%= f.label :invoice, 'Factura (PDF)' %>
      <%= f.file_field :invoice, accept: 'application/pdf' %>
      <%# solo si el adjunto ya está guardado: un blob pendiente (p. ej. al
          re-renderizar tras un error de validación) no tiene signed_id y revienta %>
      <% if purchase.invoice.attached? && purchase.invoice.blob&.persisted? %>
        <p class="action-note" style="margin-top:4px;">Ya adjunta: <%= link_to '📄 ver factura', rails_blob_path(purchase.invoice, disposition: 'inline'), target: '_blank', rel: 'noopener' %> (sube otra para sustituirla)</p>
      <% end %>
    </div>
    <div class="full"><%= f.label :notes, 'Notas' %><%= f.text_area :notes, rows: 2 %></div>
  </div>

  <h2 style="margin-top:24px;">Líneas de la compra</h2>
  <p class="action-note" style="margin-top:0;">Cada línea lleva su producto <strong>o un concepto libre</strong> (maquinaria, cajas… — sin producto de la tienda: no suma stock ni entra en el coste real), unidades, coste por unidad y los costes de transporte, aduanas y otros imputados a esa línea. Introduce todos los importes en la <strong>moneda seleccionada</strong>. Deja producto y concepto en blanco en las filas que no uses<% if purchase.purchase_lines.any?(&:persisted?) %>; marca «quitar» para eliminar una línea<% end %>.</p>
  <div style="overflow-x:auto;">
    <%# columnas en el orden del cálculo: qué se compra (producto/concepto, unidades, coste/ud.),
        los costes imputados (transporte, aduanas, otros), el IVA, a qué presupuesto va y el
        total de la línea. Cada celda de la fila se corresponde con su cabecera. %>
    <% removable = purchase.purchase_lines.any?(&:persisted?) %>
    <table class="table purchase-lines" style="min-width: 980px;">
      <thead>
        <tr>
          <th style="min-width:200px;">Producto / concepto</th>
          <th class="num" style="width:70px;">Uds.</th>
          <th class="num" style="width:95px;">Coste/ud.</th>
          <th class="num" style="width:90px;">Transporte</th>
          <th class="num" style="width:90px;">Aduanas</th>
          <th class="num" style="width:90px;" title="Otros costes imputados a esta línea (seguros, tasas, embalaje…)">Otros</th>
          <th style="width:95px;" title="IVA soportado de la línea: 0 % en importaciones, 21/10 % en proveedores nacionales">IVA</th>
          <th style="width:150px;" title="Imputa el coste de esta línea a un presupuesto de cliente concreto; en blanco, compra para stock">Presupuesto</th>
          <th class="num" style="width:100px;">Total línea</th>
          <% if removable %><th style="width:55px; text-align:center;">Quitar</th><% end %>
        </tr>
      </thead>
      <tbody>
        <%= f.fields_for :purchase_lines do |lf| %>
          <tr data-purchase-form-target="line">
            <td>
              <%= lf.collection_select :product_id, Product.ordered, :id, :name, { include_blank: true }, { class: 'form-select', style: 'width:100%; max-width:220px;', data: { action: 'change->purchase-form#recalc' } } %>
              <%# compra que no es un producto de la tienda: maquinaria, cajas… (no suma stock) %>
              <%= lf.text_field :description, placeholder: 'o concepto libre (maquinaria, cajas…)', style: 'margin-top:4px; font-size:13px; width:100%; max-width:220px;' %>
            </td>
            <td class="num"><%= lf.number_field :quantity, min: 1, style: 'width:65px; text-align:right;', data: { field: 'quantity', action: 'input->purchase-form#recalc' } %></td>
            <td class="num"><%= lf.number_field :unit_cost, step: 0.0001, min: 0, style: 'width:90px; text-align:right;', data: { field: 'unit_cost', action: 'input->purchase-form#recalc' } %></td>
            <td class="num"><%= lf.number_field :shipping_cost, step: 0.01, min: 0, style: 'width:85px; text-align:right;', data: { field: 'shipping_cost', action: 'input->purchase-form#recalc' } %></td>
            <td class="num"><%= lf.number_field :customs_cost, step: 0.01, min: 0, style: 'width:85px; text-align:right;', data: { field: 'customs_cost', action: 'input->purchase-form#recalc' } %></td>
            <td class="num"><%= lf.number_field :other_costs, step: 0.01, min: 0, style: 'width:85px; text-align:right;', data: { field: 'other_costs', action: 'input->purchase-form#recalc' } %></td>
            <td>
              <%# selected explícito: el valor es decimal (21.0) y no casaría con el
                  entero de la opción, dejando el desplegable en «Sin IVA» %>
              <%= lf.select :vat_rate, PurchaseLine::VAT_OPTIONS, { selected: lf.object.vat_rate.to_i },
                            { class: 'form-select', style: 'width:90px;', data: { field: 'vat_rate', action: 'change->purchase-form#recalc' } } %>
              <div class="action-note" style="margin-top:2px; text-align:right;" data-line-vat></div>
            </td>
            <td><%= lf.select :quote_id, @quotes_for_imputation.map { |q| ["#{q.number} · #{q.client.name.truncate(18)}", q.id] },
                              { include_blank: '— stock —' }, { class: 'form-select', style: 'width:100%; max-width:150px; font-size:13px;' } %></td>
            <td class="num"><strong data-line-total>—</strong></td>
            <% if removable %>
              <td style="text-align:center;"><%= lf.check_box :_destroy if lf.object.persisted? %></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr>
          <td colspan="3" class="field-label" style="text-align:right;">Totales</td>
          <td class="num"><strong data-purchase-form-target="totalShipping">—</strong></td>
          <td class="num"><strong data-purchase-form-target="totalCustoms">—</strong></td>
          <td class="num"><strong data-purchase-form-target="totalOther">—</strong></td>
          <td class="num"><strong data-purchase-form-target="totalVat">—</strong></td>
          <td></td>
          <td class="num"><strong data-purchase-form-target="totalInvoice">—</strong></td>
          <% if removable %><td></td><% end %>
        </tr>
        <tr>
          <td colspan="3"></td>
          <td class="field-label num">Transporte</td>
          <td class="field-label num">Aduanas</td>
          <td class="field-label num">Otros</td>
          <td class="field-label num">IVA</td>
          <td></td>
          <td class="field-label num">Total factura (IVA incl.)</td>
          <% if removable %><td></td><% end %>
        </tr>
      </tfoot>
    </table>
  </div>
  <p class="action-note">Los totales de arriba se muestran en la moneda seleccionada. Si la compra es en dólares, su valor en euros (con el tipo de cambio de la factura) aparece al guardar la compra.</p>

  <p><%= f.submit 'Guardar compra', class: 'btn btn-primary' %> <%= link_to 'Cancelar', admin_purchases_path, class: 'btn btn-outline' %></p>
<% end %>
