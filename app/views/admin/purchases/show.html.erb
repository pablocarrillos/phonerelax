<p><%= link_to '← Volver a compras', admin_purchases_path %></p>
<h1>Compra de <%= @purchase.supplier.name %> · <%= l @purchase.ordered_on, format: '%d/%m/%Y' %></h1>

<div class="order-actions">
  <p class="order-badges">
    <% if @purchase.received? %>
      <span class="badge recibido">recibida el <%= l @purchase.received_on, format: '%d/%m/%Y' %></span>
    <% else %>
      <span class="badge pendiente">pendiente de recibir</span>
    <% end %>
    <% if @purchase.reference.present? %>&nbsp;&nbsp;<strong>Ref.:</strong> <%= @purchase.reference %><% end %>
    <% if @purchase.invoice.attached? %>&nbsp;&nbsp;<%= link_to '📄 Ver factura', rails_blob_path(@purchase.invoice, disposition: 'inline'), target: '_blank', rel: 'noopener' %><% end %>
  </p>

  <div class="action-section">
    <div class="action-row">
      <% if @purchase.received? %>
        <%= button_to '↩ Deshacer recepción', unreceive_admin_purchase_path(@purchase), method: :patch, class: 'btn btn-outline',
                      form: { data: { turbo_confirm: '¿Deshacer la recepción? Se restarán del stock las unidades de esta compra.' } } %>
      <% else %>
        <%= button_to '✓ Marcar como recibida', receive_admin_purchase_path(@purchase), method: :patch, class: 'btn btn-primary',
                      form: { data: { turbo_confirm: '¿Marcar la compra como recibida? Las unidades se sumarán al stock de cada producto.' } } %>
      <% end %>
      <%= link_to 'Editar', edit_admin_purchase_path(@purchase), class: 'btn btn-outline' %>
      <% unless @purchase.received? %>
        <%= button_to '🗑 Borrar', admin_purchase_path(@purchase), method: :delete, class: 'btn btn-danger',
                      form: { data: { turbo_confirm: '¿Borrar esta compra?' } } %>
      <% end %>
    </div>
  </div>
</div>

<% sym = @purchase.usd? ? '$' : '€' %>
<h2>Líneas</h2>
<% if @purchase.usd? %>
  <p class="action-note">Importes en <strong>dólares</strong>. Tipo de cambio de la fecha de factura (<%= @purchase.invoice_date ? l(@purchase.invoice_date, format: '%d/%m/%Y') : '—' %>): <strong>1&nbsp;$ = <%= number_with_precision(@purchase.exchange_rate || 1, precision: 4) %>&nbsp;€</strong>. El «coste real/ud.» y el total en euros ya están convertidos.</p>
<% end %>
<table class="table" style="max-width: 860px;">
  <thead><tr><th>Producto</th><th class="num">Unidades</th><th class="num">Coste/ud.</th><th class="num">Subtotal</th><th class="num">Coste real/ud. (€)*</th></tr></thead>
  <tbody>
    <% @purchase.purchase_lines.each do |line| %>
      <tr>
        <td><%= line.product.name %></td>
        <td class="num"><%= line.quantity %></td>
        <td class="num"><%= number_to_currency(line.unit_cost, unit: sym, format: '%n %u') %></td>
        <td class="num"><%= number_to_currency(line.subtotal, unit: sym, format: '%n %u') %></td>
        <td class="num"><strong><%= number_to_currency(@purchase.landed_unit_cost(line), unit: '€', format: '%n %u') %></strong></td>
      </tr>
    <% end %>
    <tr><td colspan="3">Transporte</td><td class="num" colspan="2"><%= number_to_currency(@purchase.shipping_cost, unit: sym, format: '%n %u') %></td></tr>
    <tr><td colspan="3">Aduanas / trámites</td><td class="num" colspan="2"><%= number_to_currency(@purchase.customs_cost, unit: sym, format: '%n %u') %></td></tr>
    <tr><td colspan="3">Otros costes</td><td class="num" colspan="2"><%= number_to_currency(@purchase.other_costs, unit: sym, format: '%n %u') %></td></tr>
    <tr class="total-row"><td colspan="3">Total compra<%= " (#{sym})".html_safe if @purchase.usd? %></td><td class="num" colspan="2"><%= number_to_currency(@purchase.total_cost, unit: sym, format: '%n %u') %></td></tr>
    <% if @purchase.usd? %>
      <tr class="total-row"><td colspan="3">Total en euros</td><td class="num" colspan="2"><strong><%= number_to_currency(@purchase.total_cost_eur, unit: '€', format: '%n %u') %></strong></td></tr>
    <% end %>
  </tbody>
</table>
<p class="action-note">* Coste real por unidad, en euros: precio de compra más la parte proporcional de transporte, aduanas y otros costes, convertido con el tipo de cambio de la factura.</p>

<% if @purchase.notes.present? %>
  <h2>Notas</h2>
  <p><%= simple_format(@purchase.notes) %></p>
<% end %>
