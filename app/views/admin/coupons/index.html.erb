<div style="display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap;">
  <h1 style="margin:0;">Cupones</h1>
  <%= link_to '+ Nuevo cupón', new_admin_coupon_path, class: 'btn btn-primary' %>
</div>
<p class="action-note" style="margin-top:8px;">El cliente los aplica en el checkout («¿Tienes un cupón?»). El porcentaje descuenta sobre la base (sin IVA); la cantidad exacta, sobre el total con IVA de los productos. El transporte nunca se descuenta. Cada uso avisa por email al promotor.</p>

<% if @coupons.empty? %>
  <p>No hay cupones. Mientras no exista ninguno, el checkout no muestra el campo de cupón.</p>
<% else %>
  <table class="table">
    <thead><tr><th>Código</th><th>Estado</th><th>Descuento</th><th>Vigencia</th><th class="num">Usos</th><th>Avisar a</th><th></th></tr></thead>
    <tbody>
      <% @coupons.each do |coupon| %>
        <tr>
          <td><strong style="font-family:monospace; font-size:15px;"><%= coupon.code %></strong></td>
          <td>
            <% if coupon.redeemable? %>
              <span class="badge pagado">Activo</span>
            <% else %>
              <span class="badge pendiente" title="<%= coupon.rejection_reason %>">
                <%= { disabled: "Deshabilitado", not_started: "Aún no en vigor", expired: "Caducado", exhausted: "Agotado" }[coupon.rejection_reason] %>
              </span>
            <% end %>
          </td>
          <td><%= coupon.discount_label %></td>
          <td style="font-size:14px;">
            <% if coupon.starts_on || coupon.ends_on %>
              <%= coupon.starts_on ? l(coupon.starts_on, format: '%d/%m/%Y') : '…' %> → <%= coupon.ends_on ? l(coupon.ends_on, format: '%d/%m/%Y') : '…' %>
            <% else %>
              <span style="color:var(--muted);">Sin límite</span>
            <% end %>
          </td>
          <td class="num"><%= coupon.uses_count %><%= " / #{coupon.max_uses}" if coupon.max_uses %></td>
          <td style="font-size:13px; color:var(--muted); word-break:break-all;"><%= coupon.notify_email_list.join(", ").presence || '—' %></td>
          <td style="text-align:right; white-space:nowrap;">
            <%= link_to 'Editar', edit_admin_coupon_path(coupon), class: 'btn btn-outline', style: 'padding:5px 12px; font-size:13px;' %>
            <%= button_to 'Borrar', admin_coupon_path(coupon), method: :delete, class: 'btn btn-danger',
                          form: { style: 'display:inline;', data: { turbo_confirm: "¿Borrar el cupón #{coupon.code}? Dejará de poder usarse (los pedidos pasados conservan su descuento)." } },
                          style: 'padding:5px 12px; font-size:13px;' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<h2 style="margin-top: 34px;">Uso de los cupones</h2>
<p class="action-note" style="margin-top:0;">Pedidos cobrados con cupón (los reembolsados después también salen, marcados). El rango filtra por la fecha del pedido.</p>

<%= form_with url: admin_coupons_path, method: :get, local: true,
              html: { style: 'margin: 0 0 14px; display:flex; gap:10px; align-items:center; flex-wrap:wrap;' } do %>
  <%= select_tag :coupon_id,
        options_for_select([["Todos los cupones", ""]] + Coupon.order(:code).pluck(:code, :id), params[:coupon_id]),
        class: 'form-select', style: 'width:auto;' %>
  <label for="from" style="font-size:14px; font-weight:600; color:var(--muted); margin:0;">Desde</label>
  <%= datetime_field_tag :from, params[:from], id: 'from', class: 'input-compact', style: 'margin:0;' %>
  <label for="to" style="font-size:14px; font-weight:600; color:var(--muted); margin:0;">hasta</label>
  <%= datetime_field_tag :to, params[:to], id: 'to', class: 'input-compact', style: 'margin:0;' %>
  <button type="submit" class="btn btn-outline" style="padding:5px 14px; font-size:14px;">Filtrar</button>
  <% if @uses_coupon || @uses_from || @uses_to %>
    <%= link_to 'Quitar filtros', admin_coupons_path, class: 'btn btn-danger-link' %>
  <% end %>
<% end %>

<% if @uses.empty? %>
  <p>Ningún pedido con cupón<%= " #{@uses_coupon.code}" if @uses_coupon %><%= " en ese rango" if @uses_from || @uses_to %>.</p>
<% else %>
  <table class="table">
    <thead>
      <tr><th>Pedido</th><th>Fecha</th><th>Cupón</th><th>Cliente</th><th class="num">Descuento</th><th class="num">Total (sin IVA)</th><th class="num">Total (con IVA)</th><th></th></tr>
      <%# totales de lo filtrado, siempre a la vista %>
      <tr class="total-row">
        <th colspan="4" style="text-align:right;">Totales · <%= @uses.size %> <%= "pedido".pluralize(@uses.size) %></th>
        <th class="num">−<%= number_to_currency(@uses_total_discount, unit: '€', format: '%n %u') %></th>
        <th class="num"><%= number_to_currency(@uses_total_net, unit: '€', format: '%n %u') %></th>
        <th class="num"><%= number_to_currency(@uses_total_gross, unit: '€', format: '%n %u') %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @uses.each do |order| %>
        <tr>
          <td><%= link_to order.number, admin_order_path(order) %></td>
          <td><%= l order.created_at, format: :short %></td>
          <td><strong style="font-family:monospace;"><%= order.coupon_code %></strong></td>
          <td><%= order.customer_name %></td>
          <td class="num">−<%= number_to_currency(order.coupon_discount, unit: '€', format: '%n %u') %></td>
          <td class="num"><%= number_to_currency(order.total.to_d - order.vat_breakdown[:vat], unit: '€', format: '%n %u') %></td>
          <td class="num"><strong><%= number_to_currency(order.total, unit: '€', format: '%n %u') %></strong></td>
          <td><% if order.pago_reembolsado? %><span class="badge reembolsado">Reembolsado</span><% end %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
