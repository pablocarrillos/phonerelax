<p><%= link_to '← Volver a leads', admin_leads_path %></p>

<h1>
  <%= @lead.full_name %>
  <span class="badge"><%= @lead.status %></span>
  <% if @lead.to_answer? %><span class="badge" style="background:#b7791f; color:#fff;">A contestar</span><% end %>
</h1>

<p>
  <%= link_to 'Editar', edit_admin_lead_path(@lead), class: 'btn btn-outline' %>
  <%= button_to '🗑 Borrar', admin_lead_path(@lead), method: :delete, class: 'btn btn-danger',
                form: { data: { turbo_confirm: "¿Borrar el lead #{@lead.full_name} y todo su historial?" } } %>
</p>

<div class="form-grid" style="max-width: 980px;">
  <div>
    <h2>Datos</h2>
    <p>
      <% if @lead.lead_emails.any? %><strong>Emails:</strong> <%= @lead.lead_emails.map(&:email).join(", ") %><br><% end %>
      <% if @lead.phone.present? %><strong>Teléfono:</strong> <%= @lead.phone %><br><% end %>
      <% if @lead.city.present? %><strong>Ciudad:</strong> <%= @lead.city %><br><% end %>
      <% if @lead.origin.present? %><strong>Origen:</strong> <%= @lead.origin %><br><% end %>
      <% if @lead.email_subject.present? %><strong>Asunto email:</strong> <%= @lead.email_subject %><br><% end %>
      <% if @lead.budget_amount.present? %><strong>Presupuesto actual:</strong> <%= number_to_currency(@lead.budget_amount, unit: '€', format: '%n %u') %> <span class="action-note" style="display:inline;">(lo fijan las gestiones)</span><br><% end %>
      <strong>Última actividad:</strong> <%= l @lead.latest_activity_at, format: :short %> (hace <%= @lead.days_without_contact %> días)
    </p>

    <h2>Responder con plantilla</h2>
    <% if @lead.primary_email.blank? %>
      <p class="action-note">El lead no tiene email.</p>
    <% elsif @templates.blank? %>
      <p class="action-note"><%= link_to 'Crea una plantilla', new_admin_email_template_path %> para responder desde aquí.</p>
    <% else %>
      <% @templates.each do |template| %>
        <p style="margin: 4px 0;">
          <%= link_to "✉ #{template.name}", gmail_compose_url(@lead, template), target: '_blank', rel: 'noopener', class: 'btn btn-outline' %>
          <%= button_to '✓ Enviada', mark_template_sent_admin_lead_path(@lead, template_id: template.id), method: :post,
                        class: 'btn btn-outline', form: { style: 'display:inline;' },
                        title: 'Apuntar en el historial que se envió esta plantilla' %>
        </p>
      <% end %>
      <p class="action-note">
        Se abre Gmail con la respuesta cargada
        <%= @lead.email_subject.present? ? "con el asunto «#{@lead.email_subject}»" : "(sin asunto guardado: usa el de la plantilla)" %>.
        Tras enviarla, pulsa «✓ Enviada» para dejarlo en el historial.
      </p>
    <% end %>

    <h2>Muestras y presupuesto</h2>
    <p>
      <%= link_to '📦 Enviar muestra', new_admin_sample_path(lead_id: @lead.id), class: 'btn btn-primary' %>
      <% if @lead.client %>
        <%= link_to '🧾 Generar presupuesto', new_admin_quote_path(client_id: @lead.client_id, lead_id: @lead.id), class: 'btn btn-primary' %>
      <% else %>
        <%= link_to '🧾 Añadir datos fiscales y generar presupuesto', new_admin_client_path(lead_id: @lead.id), class: 'btn btn-primary' %>
      <% end %>
    </p>
    <% if @lead.client %>
      <p><strong>Cliente:</strong> <%= link_to @lead.client.name, edit_admin_client_path(@lead.client) %><%= " · NIF #{@lead.client.tax_id}" if @lead.client.tax_id.present? %></p>
    <% else %>
      <p class="action-note">Sin datos fiscales todavía: al añadirlos se crea el cliente y se puede generar el presupuesto.</p>
    <% end %>
    <% if @lead.samples.any? %>
      <p>
        <strong>Muestras enviadas:</strong><br>
        <% @lead.samples.sort_by { |s| s.sent_on || s.created_at.to_date }.reverse.each do |sample| %>
          <%= link_to "Muestra a #{sample.organization}", edit_admin_sample_path(sample) %>
          · <%= sample.sent_on ? l(sample.sent_on, format: :long) : 'sin fecha' %>
          · <%= sample.returned? ? 'devuelta' : 'fuera' %><%= ' · 💰 con venta' if sample.sold? %><br>
        <% end %>
      </p>
    <% end %>
    <% if @lead.quotes.any? %>
      <p>
        <strong>Presupuestos generados:</strong><br>
        <% @lead.quotes.recent_first.each do |quote| %>
          <%= link_to quote.number, admin_quote_path(quote) %>
          · <%= l quote.issued_on, format: :long %>
          · <%= number_to_currency(quote.total, unit: '€', format: '%n %u') %>
          · <%= quote.status_label %><br>
        <% end %>
      </p>
    <% end %>
  </div>

  <div>
    <h2>Nueva gestión</h2>
    <% if @lead_management.errors.any? %>
      <div class="errors"><ul><% @lead_management.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul></div>
    <% end %>
    <%= form_with model: [ :admin, @lead, @lead_management ], url: admin_lead_managements_path(@lead), local: true do |f| %>
      <div class="form-grid">
        <div><%= f.label :status, 'Nuevo estado' %><%= f.select :status, Lead::STATUSES, {}, { class: 'form-select' } %></div>
        <div><%= f.label :channel, 'Canal' %><%= f.select :channel, LeadManagement::CHANNELS - %w[Muestra Presupuesto], {}, { class: 'form-select' } %></div>
        <div><%= f.label :happened_at, 'Fecha y hora' %><%= f.datetime_field :happened_at %></div>
        <div>
          <%= f.label :budget_amount, 'Presupuesto (€)' %>
          <%= f.number_field :budget_amount, step: 0.01, min: 0 %>
          <div class="action-note">Solo con estados «Presupuestado …».</div>
        </div>
        <div class="full"><%= f.label :action, 'Acción / resumen del contacto' %><%= f.text_area :action, rows: 4 %></div>
      </div>
      <p><%= f.submit 'Añadir gestión', class: 'btn btn-primary' %></p>
    <% end %>
  </div>
</div>

<h2 style="margin-top: 20px;">Historial de gestiones</h2>
<%# solo las guardadas: la gestión en blanco del formulario también vive en la asociación %>
<% history = @lead.lead_managements.reject(&:new_record?) %>
<% if history.empty? %>
  <p class="action-note">Sin gestiones todavía.</p>
<% else %>
  <table class="table" style="max-width: 1080px;">
    <thead><tr><th>Fecha</th><th>Canal</th><th>Estado</th><th>Presupuesto</th><th>Acción</th><th></th></tr></thead>
    <tbody>
      <% history.each do |management| %>
        <tr>
          <td style="white-space:nowrap;"><%= l management.happened_at, format: :short %></td>
          <td><%= management.channel %></td>
          <td><%= management.status %></td>
          <td><%= management.budget_amount.present? ? number_to_currency(management.budget_amount, unit: '€', format: '%n %u') : '—' %></td>
          <td><%= simple_format(management.action) %></td>
          <td>
            <%= button_to '✕', admin_lead_management_path(@lead, management), method: :delete, class: 'btn-danger-link',
                          form: { data: { turbo_confirm: '¿Borrar esta gestión? El estado del lead se recalculará con la anterior.' } } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
