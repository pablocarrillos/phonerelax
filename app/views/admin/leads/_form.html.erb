<%= form_with model: [ :admin, lead ], local: true do |f| %>
  <% if lead.errors.any? %>
    <div class="errors"><ul><% lead.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul></div>
  <% end %>

  <div class="form-grid" style="max-width: 760px;">
    <div><%= f.label :name, 'Nombre *' %><%= f.text_field :name, placeholder: 'p. ej. Colegio San José' %></div>
    <div><%= f.label :last_name, 'Apellidos' %><%= f.text_field :last_name %></div>
    <div><%= f.label :origin, 'Origen' %><%= f.text_field :origin, placeholder: 'web, llamada, feria…' %></div>
    <div class="full"><%= f.label :email_list, 'Emails (separados por comas o espacios)' %><%= f.text_field :email_list, placeholder: 'email@dominio.com, otro@dominio.com' %></div>
    <div class="full"><%= f.label :email_subject, 'Asunto del email del lead' %><%= f.text_field :email_subject, placeholder: 'cópialo de Gmail: la respuesta saldrá con este mismo asunto' %></div>
    <div><%= f.label :phone, 'Teléfono' %><%= f.telephone_field :phone %></div>
    <div><%= f.label :city, 'Ciudad' %><%= f.text_field :city %></div>
    <div><%= f.label :status, 'Estado' %><%= f.select :status, Lead::STATUSES, {}, { class: 'form-select' } %></div>
    <div><label style="font-weight:400;"><%= f.check_box :to_answer %> A contestar</label></div>
  </div>

  <p>
    <%= f.submit lead.new_record? ? 'Crear lead' : 'Guardar lead', class: 'btn btn-primary' %>
    <%= link_to 'Cancelar', lead.new_record? ? admin_leads_path : admin_lead_path(lead), class: 'btn btn-outline' %>
  </p>
<% end %>
