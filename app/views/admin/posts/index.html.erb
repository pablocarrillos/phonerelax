<h1>Blog</h1>
<p><%= link_to 'Nuevo artículo', new_admin_post_path, class: 'btn btn-primary' %></p>
<table class="table">
  <thead><tr><th>Título</th><th>Fecha</th><th></th></tr></thead>
  <tbody>
    <% @posts.each do |post| %>
      <tr>
        <td><%= link_to post.title, blog_post_path(post) %></td>
        <td><%= post.published_on %></td>
        <td>
          <%= link_to 'Editar', edit_admin_post_path(post), class: 'btn btn-outline', style: 'padding: 5px 12px; font-size: 13px;' %>
          <%= button_to 'Borrar', admin_post_path(post), method: :delete, form: { style: 'display:inline;', data: { turbo_confirm: '¿Borrar este artículo?' } }, class: 'btn-danger-link' %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
