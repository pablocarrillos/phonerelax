<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
<% @entries.each do |entry| %>
  <% entry[:urls].each do |locale, url| %>
  <url>
    <loc><%= url %></loc>
    <% entry[:urls].each do |alt_locale, alt_url| %>
    <xhtml:link rel="alternate" hreflang="<%= alt_locale %>" href="<%= alt_url %>"/>
    <% end %>
    <xhtml:link rel="alternate" hreflang="x-default" href="<%= entry[:urls][I18n.default_locale] %>"/>
    <% if entry[:lastmod] %><lastmod><%= entry[:lastmod] %></lastmod><% end %>
    <% if entry[:changefreq] %><changefreq><%= entry[:changefreq] %></changefreq><% end %>
    <% if entry[:priority] %><priority><%= entry[:priority] %></priority><% end %>
  </url>
  <% end %>
<% end %>
</urlset>
