<h1 style="font-size:20px; margin:0 0 12px;"><%= t('order_mailer.payment_reminder.title') %></h1>
<p><%= t('order_mailer.payment_reminder.body_html', name: @order.customer_name, number: @order.number) %></p>
<%= render 'order_summary' %>
<p style="text-align:center; margin:22px 0;">
  <a href="<%= order_pay_url(@order.number) %>" style="background:#D60BC6; color:#fff; text-decoration:none; padding:12px 26px; border-radius:8px; display:inline-block;"><%= t('order_mailer.payment_reminder.pay') %></a>
</p>
<p style="color:#8a8fa8; font-size:13px;"><%= t('order_mailer.payment_reminder.no_action') %></p>
