<table style="width:100%; border-collapse:collapse; margin:16px 0;">
  <% @order.order_lines.each do |line| %>
    <tr>
      <td style="padding:8px 0; border-bottom:1px solid #e8e9f2;"><%= line.product.display_name %> × <%= line.quantity %></td>
      <td style="padding:8px 0; border-bottom:1px solid #e8e9f2; text-align:right;"><%= number_to_currency(line.subtotal, unit: '€', format: '%n %u') %></td>
    </tr>
  <% end %>
  <% if @order.shipping_cost.positive? %>
    <tr>
      <td style="padding:8px 0; border-bottom:1px solid #e8e9f2;"><%= t('order_mailer.summary.shipping') %></td>
      <td style="padding:8px 0; border-bottom:1px solid #e8e9f2; text-align:right;"><%= number_to_currency(@order.shipping_cost, unit: '€', format: '%n %u') %></td>
    </tr>
  <% end %>
  <% breakdown = @order.vat_breakdown %>
  <tr>
    <td style="padding:8px 0; border-bottom:1px solid #e8e9f2;"><%= t('checkout.base') %></td>
    <td style="padding:8px 0; border-bottom:1px solid #e8e9f2; text-align:right;"><%= number_to_currency(breakdown[:base], unit: '€', format: '%n %u') %></td>
  </tr>
  <tr>
    <td style="padding:8px 0; border-bottom:1px solid #e8e9f2;"><%= breakdown[:rate] ? t('common.vat_rate', rate: breakdown[:rate]) : t('checkout.vat') %></td>
    <td style="padding:8px 0; border-bottom:1px solid #e8e9f2; text-align:right;"><%= number_to_currency(breakdown[:vat], unit: '€', format: '%n %u') %></td>
  </tr>
  <% if @order.vat_exempt? %>
    <tr>
      <td colspan="2" style="padding:8px 0; border-bottom:1px solid #e8e9f2; color:#666; font-size:13px;"><%= t("vat_exempt.#{@order.vat_exempt_reason}") %></td>
    </tr>
  <% end %>
  <tr>
    <td style="padding:10px 0; font-weight:bold;"><%= t('order_mailer.summary.total') %></td>
    <td style="padding:10px 0; font-weight:bold; text-align:right;"><%= number_to_currency(@order.total, unit: '€', format: '%n %u') %></td>
  </tr>
</table>
