<h1 style="font-size:20px; margin:0 0 12px;">¡Gracias por tu compra, <%= @order.customer_name %>!</h1>
<p>Hemos recibido el pago de tu pedido <strong><%= @order.number %></strong>. Lo estamos preparando y te avisaremos cuando salga hacia tu dirección.</p>
<%= render 'order_summary' %>
<p style="text-align:center; margin:22px 0;">
  <a href="<%= order_status_url(@order.number) %>" style="background:#0E1B4D; color:#fff; text-decoration:none; padding:12px 26px; border-radius:8px; display:inline-block;">Seguir mi pedido</a>
</p>
