<h1 style="font-size:20px; margin:0 0 12px;"><%= t('order_mailer.shipped.title') %></h1>
<p><%= t('order_mailer.shipped.body_html', name: @order.customer_name, number: @order.number) %></p>
<p style="background:#f5f6fb; border-radius:8px; padding:12px 16px;">
  <%= [@order.address, @order.postal_code, @order.city, @order.province, @order.country].compact_blank.join(', ') %>
</p>
<% if @order.tracking_number.present? %>
  <p style="padding:4px 0;"><strong><%= t('order_mailer.shipped.tracking_label') %>:</strong>
    <%= @order.tracking_carrier.presence %>
    <% if @order.tracking_url %><a href="<%= @order.tracking_url %>"><%= @order.tracking_number %></a><% else %><%= @order.tracking_number %><% end %></p>
<% end %>
<%= render 'order_summary' %>
<p style="text-align:center; margin:22px 0;">
  <a href="<%= order_status_url(@order.number) %>" style="background:#0E1B4D; color:#fff; text-decoration:none; padding:12px 26px; border-radius:8px; display:inline-block;"><%= t('order_mailer.shipped.track') %></a>
</p>
