<!DOCTYPE html>
<html lang="es">
  <head>
    <title>PhoneRelax · Admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="icon" type="image/svg+xml" href="/icon.svg">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;800&family=Questrial&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/trix@2.1.15/dist/trix.css">
    <%= stylesheet_link_tag :app %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <header class="admin-header">
      <div class="admin-header-inner">
        <div style="display: flex; align-items: center; flex-wrap: wrap;">
          <%= link_to root_path, class: 'brand', style: 'margin-right: 24px;', title: 'Ir a la tienda' do %><span>PHONE</span><span>RELAX</span><% end %>
          <% ventas_active = %w[orders stats].include?(controller_name) %>
          <details class="admin-dropdown" data-controller="dropdown-hover" data-action="mouseenter->dropdown-hover#open mouseleave->dropdown-hover#close">
            <summary class="<%= 'active' if ventas_active %>">Ventas<% if pending_to_prepare_count.positive? %><span class="nav-badge"><%= pending_to_prepare_count %></span><% end %></summary>
            <div class="admin-menu">
              <%= link_to admin_orders_path, class: ('active' if controller_name == 'orders') do %>Pedidos<% if pending_to_prepare_count.positive? %><span class="nav-badge"><%= pending_to_prepare_count %></span><% end %><% end %>
              <%= link_to 'Estadísticas', admin_stats_path, class: ('active' if controller_name == 'stats') %>
            </div>
          </details>
          <% tienda_active = %w[products purchases suppliers shipping].include?(controller_name) %>
          <details class="admin-dropdown" data-controller="dropdown-hover" data-action="mouseenter->dropdown-hover#open mouseleave->dropdown-hover#close">
            <summary class="<%= 'active' if tienda_active %>">Tienda</summary>
            <div class="admin-menu">
              <%= link_to 'Productos', admin_products_path, class: ('active' if controller_name == 'products') %>
              <%= link_to 'Compras', admin_purchases_path, class: ('active' if %w[purchases suppliers].include?(controller_name)) %>
              <%= link_to 'Transporte', admin_shipping_path, class: ('active' if controller_name == 'shipping') %>
            </div>
          </details>
          <% comercial_active = %w[quotes clients samples].include?(controller_name) %>
          <details class="admin-dropdown" data-controller="dropdown-hover" data-action="mouseenter->dropdown-hover#open mouseleave->dropdown-hover#close">
            <summary class="<%= 'active' if comercial_active %>">Comercial</summary>
            <div class="admin-menu">
              <%= link_to 'Presupuestos', admin_quotes_path, class: ('active' if %w[quotes clients].include?(controller_name)) %>
              <%= link_to 'Muestras', admin_samples_path, class: ('active' if controller_name == 'samples') %>
            </div>
          </details>
          <%= link_to 'Admins', admin_users_path, class: ('active' if controller_name == 'users') %>
        </div>
        <div class="admin-header-user">
        <span><%= Current.user&.name.presence || Current.user&.email_address %></span>
        <%= button_to 'Salir', session_path, method: :delete, class: 'btn btn-exit' %>
      </div>
      </div>
    </header>

    <%# Sub-barra del grupo activo: navegación directa sin depender del hover. %>
    <% subnav =
         if %w[orders stats].include?(controller_name)
           [ [ "Pedidos", admin_orders_path, controller_name == "orders" ],
             [ "Estadísticas", admin_stats_path, controller_name == "stats" ] ]
         elsif %w[products purchases suppliers shipping].include?(controller_name)
           [ [ "Productos", admin_products_path, controller_name == "products" ],
             [ "Compras", admin_purchases_path, %w[purchases suppliers].include?(controller_name) ],
             [ "Transporte", admin_shipping_path, controller_name == "shipping" ] ]
         elsif %w[quotes clients samples].include?(controller_name)
           [ [ "Presupuestos", admin_quotes_path, %w[quotes clients].include?(controller_name) ],
             [ "Muestras", admin_samples_path, controller_name == "samples" ] ]
         end %>
    <% if subnav %>
      <nav class="admin-subnav">
        <div class="admin-subnav-inner">
          <% subnav.each do |(label, path, active)| %>
            <%= link_to label, path, class: "subnav-link #{'active' if active}" %>
          <% end %>
        </div>
      </nav>
    <% end %>

    <main class="admin-main">
      <% flash.each do |kind, message| %>
        <div class="flash <%= kind %>"><%= message %></div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
