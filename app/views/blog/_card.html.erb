<div class="card blog-card">
  <%= link_to blog_post_path(post) do %>
    <img src="<%= post.image_url %>" alt="<%= post.title %>">
  <% end %>
  <h3><%= link_to post.title, blog_post_path(post), style: 'text-decoration:none;' %></h3>
  <p class="step"><%= post.excerpt %></p>
  <div class="actions"><%= link_to 'Leer artículo →', blog_post_path(post), class: 'read-more' %></div>
</div>
