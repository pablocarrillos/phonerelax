<% content_for :title, "#{@product.display_name} · PhoneRelax" %>
<% content_for :description, plain_summary(@product.display_description) %>
<% content_for :og_image, @product.gallery_urls.first %>
<% breadcrumb_items = [[t('nav.home'), root_path], [@product.display_name, product_page_path(@product)]] %>
<% content_for :json_ld do %>
  <%= json_ld_tag(
        '@context' => 'https://schema.org',
        '@type' => 'Product',
        'name' => @product.display_name,
        'description' => plain_summary(@product.display_description),
        'image' => @product.gallery_urls.map { |u| absolute_url(u) },
        'sku' => @product.shopify_handle.presence || @product.id.to_s,
        'brand' => { '@type' => 'Brand', 'name' => 'PhoneRelax' },
        'offers' => {
          '@type' => 'Offer',
          'url' => canonical_url,
          'priceCurrency' => 'EUR',
          'price' => format('%.2f', @product.display_price),
          'availability' => @product.out_of_stock? ? 'https://schema.org/OutOfStock' : 'https://schema.org/InStock',
          'itemCondition' => 'https://schema.org/NewCondition'
        }
      ) %>
  <%= json_ld_tag(breadcrumb_schema(breadcrumb_items)) %>
<% end %>
<div class="container">
  <%= render_breadcrumbs(breadcrumb_items) %>
  <div class="product-page">
    <div data-controller="gallery">
      <img src="<%= @product.gallery_urls.first %>" alt="<%= @product.display_name %>" data-gallery-target="main">
      <% if @product.gallery_urls.size > 1 %>
        <div class="gallery-thumbs">
          <% @product.gallery_urls.each_with_index do |url, i| %>
            <button type="button" class="gallery-thumb <%= 'active' if i.zero? %>" data-gallery-target="thumb"
                    data-action="gallery#show" data-gallery-url-param="<%= url %>" aria-label="<%= t('common.image_n', n: i + 1) %>">
              <img src="<%= url %>" alt="">
            </button>
          <% end %>
        </div>
      <% end %>
    </div>
    <%= tag.div data: (@product.pack? ? { controller: 'pack-quantity', 'pack-quantity-url-value': pack_price_path(@product), 'pack-quantity-available-value': @product.available_stock } : {}) do %>
      <h1><%= @product.display_name %></h1>
      <div class="price" data-pack-quantity-target="price"><%= number_to_currency(@product.display_price, unit: '€', format: "%n %u") %></div>
      <p class="vat-note"><%= t('common.vat_included', rate: @product.vat_percentage.to_s.sub(/\.0+\z/, '')) %></p>

      <% if @product.pack? %>
        <% saving_text = ->(amount, pct) { amount.positive? ? "#{number_to_currency(amount, unit: '€', format: "%n %u")} (#{number_to_percentage(pct, precision: 1)})" : '—' } %>
        <div class="pack-breakdown">
          <h2><%= t('product.pack_includes') %></h2>
          <table class="table">
            <thead><tr><th><%= t('common.product') %></th><th class="num"><%= t('common.quantity') %></th><th class="num"><%= t('product.pack_normal') %></th><th class="num"><%= t('product.pack_in_pack') %></th><th class="num"><%= t('product.pack_saving') %></th></tr></thead>
            <tbody>
              <% @product.pack_breakdown_for(1).each do |r| %>
                <tr data-pack-quantity-target="row">
                  <td><%= r[:component].display_name %></td>
                  <td class="num" data-cell="units"><%= r[:units] %></td>
                  <td class="num" data-cell="base"><%= number_to_currency(r[:base_total], unit: '€', format: "%n %u") %></td>
                  <td class="num pack-in-pack" data-cell="pack"><%= number_to_currency(r[:line_total], unit: '€', format: "%n %u") %></td>
                  <td class="num pack-saving-cell" data-cell="saving"><%= saving_text.(r[:saving], r[:discount_pct]) %></td>
                </tr>
              <% end %>
              <tr class="total-row">
                <td colspan="2"><%= t('common.total') %></td>
                <td class="num" data-pack-quantity-target="totalBase"><%= number_to_currency(@product.pack_base_total, unit: '€', format: "%n %u") %></td>
                <td class="num" data-pack-quantity-target="totalPack"><%= number_to_currency(@product.pack_unit_price, unit: '€', format: "%n %u") %></td>
                <td class="num pack-saving-cell" data-pack-quantity-target="totalSaving"><%= saving_text.(@product.pack_total_saving, @product.pack_total_discount_pct) %></td>
              </tr>
            </tbody>
          </table>
          <p class="pack-saving-note" data-pack-quantity-target="note"<%= ' hidden'.html_safe unless @product.pack_total_saving.positive? %>><%= t('product.pack_saving_total', amount: number_to_currency(@product.pack_total_saving, unit: '€', format: "%n %u")) if @product.pack_total_saving.positive? %></p>
        </div>
      <% end %>

      <div class="product-description"><%= sanitize @product.display_description %></div>
      <% if @product.out_of_stock? %>
        <p><span class="btn btn-soldout" style="padding: 11px 34px;"><%= t('common.sold_out') %></span></p>
        <p style="color: var(--muted);"><%= t('product.unavailable') %></p>
        <%= link_to t('common.back'), root_path, class: 'btn btn-outline' %>
      <% else %>
      <%= form_with url: cart_add_path(@product), method: :post, local: true do %>
        <label for="quantity"><%= t('common.quantity') %><% if @product.pack? %> <span class="action-note" style="display:inline;">(<%= t('product.pack_max', n: @product.available_stock) %>)</span><% end %></label>
        <input type="number" name="quantity" id="quantity" value="1" min="1" <%= tag.attributes(max: @product.available_stock) if @product.pack? %> class="qty-input"
               <% if @product.pack? %>data-pack-quantity-target="quantity" data-action="input->pack-quantity#change"<% end %>>
        <div style="margin-top: 16px;">
          <button type="submit" class="btn btn-primary"><%= t('common.add_to_cart') %></button>
          <%= link_to t('common.back'), root_path, class: 'btn btn-outline' %>
        </div>
      <% end %>
      <% end %>
    <% end %>
  </div>
</div>
