<% slides = [
     ['Mejora de la concentración y la interacción en el aula',
      '/images/site/alumnos-en-clase.jpg'],
     ['Evita el uso de móviles en zonas sin vigilancia',
      '/images/site/toilet-scrolling.webp'],
     ['Son los usuarios los que custodian sus móviles',
      '/images/site/alumnos-con-mochila.jpg'],
     ['Disfruta del momento',
      '/images/site/disfruta-del-momento-slide.jpg']
   ] %>
<div class="container carousel" data-controller="carousel" style="margin-top: 24px;">
  <% slides.each_with_index do |(title, image), i| %>
    <div class="hero carousel-slide <%= 'active' if i.zero? %>" data-carousel-target="slide">
      <img src="<%= image %>" alt="<%= title %>" loading="<%= i.zero? ? 'eager' : 'lazy' %>">
      <div class="hero-card"><h1><%= title %></h1></div>
    </div>
  <% end %>
  <div class="carousel-controls">
    <button type="button" data-action="carousel#prev" aria-label="Anterior">‹</button>
    <% slides.each_index do |i| %>
      <button type="button" class="carousel-dot <%= 'active' if i.zero? %>" data-carousel-target="dot"
              data-action="carousel#go" data-carousel-index-param="<%= i %>" aria-label="Diapositiva <%= i + 1 %>"></button>
    <% end %>
    <button type="button" data-action="carousel#next" aria-label="Siguiente">›</button>
  </div>
</div>

<div class="container section">
  <h2>¿Cómo funciona?</h2>
  <div class="grid">
    <div class="card step-card">
      <img src="/images/site/paso-1-mete-el-telefono.jpg" alt="Mete el teléfono en la bolsa" class="step-img">
      <h3>1 · Mete el teléfono en la bolsa</h3>
      <p class="step">Mete el teléfono móvil en el interior de la bolsa PhoneRelax. A partir de ese momento se quedará con o sin cobertura dependiendo del tipo de bolsa que utilices.</p>
    </div>
    <div class="card step-card">
      <img src="/images/site/paso-2-cierra-la-bolsa.jpg" alt="Cierra la bolsa PhoneRelax" class="step-img">
      <h3>2 · Cierra la bolsa PhoneRelax</h3>
      <p class="step">Aprieta el botón de la cerradura y el teléfono quedará sellado en su interior. Será el dueño del teléfono el que lo guardará en todo momento.</p>
    </div>
    <div class="card step-card">
      <img src="/images/site/paso-3-abre-la-bolsa.jpg" alt="Abre la bolsa PhoneRelax" class="step-img">
      <h3>3 · Abre la bolsa PhoneRelax</h3>
      <p class="step">Para retirar el teléfono solo hay que acercar su cerradura a uno de los imanes especiales de apertura PhoneRelax y sacar el teléfono.</p>
    </div>
  </div>
</div>

<div class="container section">
  <h2>PhoneRelax para centros educativos</h2>
  <div class="video-block" data-controller="video" data-video-id-value="V8ubHFG1k20">
    <img src="/images/site/alumnos-en-clase.jpg" alt="PhoneRelax para centros educativos">
    <button type="button" class="video-play" data-action="video#play" aria-label="Reproducir vídeo">▶</button>
  </div>
</div>

<div class="container section" id="productos">
  <h2>Productos</h2>
  <div class="grid">
    <% @products.each do |product| %>
      <div class="card product-card">
        <%= link_to product_page_path(product) do %>
          <img src="<%= product.image_url %>" alt="<%= product.name %>">
        <% end %>
        <h3><%= link_to product.name, product_page_path(product), style: 'text-decoration:none;' %></h3>
        <div class="price"><%= number_to_currency(product.price, unit: '€', format: '%n %u') %></div>
        <div class="actions">
          <% if product.out_of_stock? %>
            <span class="btn btn-block btn-soldout">Agotado</span>
          <% else %>
            <%= button_to 'Añadir al carrito', cart_add_path(product), class: 'btn btn-primary btn-block' %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<div class="container section">
  <h2>PhoneRelax para eventos</h2>
  <div class="video-block" data-controller="video" data-video-id-value="3sTkU9dWKgM">
    <img src="/images/site/disfruta-del-momento.jpg" alt="PhoneRelax para eventos">
    <button type="button" class="video-play" data-action="video#play" aria-label="Reproducir vídeo">▶</button>
  </div>
</div>

<div class="container section">
  <h2>Nuestro blog</h2>
  <div class="grid">
    <%= render partial: 'blog/card', collection: @posts, as: :post %>
  </div>
</div>
