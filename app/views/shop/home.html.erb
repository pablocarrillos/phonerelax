<% content_for :description, t('home.meta_description') %>
<% slides = [
     [t('home.slide1'), '/images/site/alumnos-en-clase.jpg', 1600, 1067],
     [t('home.slide2'), '/images/site/toilet-scrolling.webp', 720, 480],
     [t('home.slide3'), '/images/site/alumnos-con-mochila.jpg', 1600, 1067],
     [t('home.slide4'), '/images/site/disfruta-del-momento-slide.jpg', 1200, 735]
   ] %>
<% content_for :head do %>
  <link rel="preload" as="image" href="<%= slides.first[1] %>" fetchpriority="high">
<% end %>
<div class="container carousel" data-controller="carousel" style="margin-top: 24px;">
  <% slides.each_with_index do |(title, image, w, h), i| %>
    <div class="hero carousel-slide <%= 'active' if i.zero? %>" data-carousel-target="slide">
      <img src="<%= image %>" alt="<%= strip_tags(title) %>" width="<%= w %>" height="<%= h %>"
           loading="<%= i.zero? ? 'eager' : 'lazy' %>" <%= 'fetchpriority=high'.html_safe if i.zero? %>>
      <div class="hero-card<%= ' hero-card--low' if image.include?('toilet-scrolling') %>"><h1><%= sanitize title, tags: %w[br] %></h1></div>
    </div>
  <% end %>
  <div class="carousel-controls">
    <button type="button" data-action="carousel#prev" aria-label="<%= t('common.prev') %>">‹</button>
    <% slides.each_index do |i| %>
      <button type="button" class="carousel-dot <%= 'active' if i.zero? %>" data-carousel-target="dot"
              data-action="carousel#go" data-carousel-index-param="<%= i %>" aria-label="<%= t('common.slide', n: i + 1) %>"></button>
    <% end %>
    <button type="button" data-action="carousel#next" aria-label="<%= t('common.next') %>">›</button>
  </div>
</div>

<div class="container section">
  <h2><%= t('home.how_title') %></h2>
  <div class="grid">
    <div class="card step-card">
      <img src="/images/site/paso-1-mete-el-telefono.jpg" alt="<%= t('steps.step1_alt') %>" class="step-img" width="800" height="1067" loading="lazy">
      <h3><%= t('home.step1_title') %></h3>
      <p class="step"><%= t('home.step1_body') %></p>
    </div>
    <div class="card step-card">
      <img src="/images/site/paso-2-cierra-la-bolsa.jpg" alt="<%= t('steps.step2_alt') %>" class="step-img" width="755" height="1006" loading="lazy">
      <h3><%= t('home.step2_title') %></h3>
      <p class="step"><%= t('home.step2_body') %></p>
    </div>
    <div class="card step-card">
      <img src="/images/site/paso-3-abre-la-bolsa.jpg" alt="<%= t('steps.step3_alt') %>" class="step-img" width="800" height="1000" loading="lazy">
      <h3><%= t('home.step3_title') %></h3>
      <p class="step"><%= t('home.step3_body') %></p>
    </div>
  </div>
</div>

<%= render 'shared/trusted_by' %>

<div class="container section">
  <h2><%= link_to t('home.schools_title'), sector_colegios_path, style: 'color:inherit; text-decoration:none;' %></h2>
  <div class="video-block" data-controller="video" data-video-id-value="V8ubHFG1k20">
    <img src="/images/site/alumnos-en-clase.jpg" alt="<%= t('home.schools_title') %>" width="1600" height="1067" loading="lazy">
    <button type="button" class="video-play" data-action="video#play" aria-label="<%= t('common.play_video') %>">▶</button>
  </div>
</div>

<div class="container section" id="productos">
  <h2><%= t('home.products_title') %></h2>
  <div class="grid products-grid">
    <% @products.each do |product| %>
      <div class="card product-card">
        <%= link_to product_page_path(product) do %>
          <% if product.auto_carousel? && product.gallery_urls.size > 1 %>
            <div class="card-carousel" data-controller="autocarousel">
              <% product.gallery_urls.each_with_index do |url, i| %>
                <img src="<%= url %>" alt="<%= product.display_name %>" class="card-carousel-slide <%= 'active' if i.zero? %>" data-autocarousel-target="slide" loading="lazy">
              <% end %>
            </div>
          <% else %>
            <img src="<%= product.cover_url %>" alt="<%= product.display_name %>">
          <% end %>
        <% end %>
        <h3><%= link_to product.display_name, product_page_path(product), style: 'text-decoration:none;' %></h3>
        <div class="price"><%= number_to_currency(product.display_price, unit: '€', format: '%n %u') %> <span class="price-vat"><%= t('common.vat_included_short') %></span></div>
        <div class="actions">
          <% if product.out_of_stock? %>
            <span class="btn btn-block btn-soldout"><%= t('common.sold_out') %></span>
          <% else %>
            <%= button_to t('common.add_to_cart'), cart_add_path(product), class: 'btn btn-primary btn-block' %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<div class="container section">
  <div style="background:linear-gradient(135deg, var(--navy), var(--magenta)); color:#fff; border-radius:var(--radius); padding:28px 32px; display:flex; flex-wrap:wrap; gap:18px; align-items:center; justify-content:space-between;">
    <div>
      <h2 style="color:#fff; margin:0 0 6px;"><%= t('home.bulk_cta_title') %></h2>
      <p style="margin:0; opacity:.92;"><%= t('home.bulk_cta_body') %></p>
    </div>
    <%= link_to t('home.bulk_cta_button'), quote_path, class: 'btn', style: 'background:#fff; color:var(--navy); font-weight:700; white-space:nowrap;' %>
  </div>
</div>

<%= render 'shared/customization' %>

<div class="container section">
  <h2><%= link_to t('home.events_title'), sector_eventos_path, style: 'color:inherit; text-decoration:none;' %></h2>
  <div class="video-block" data-controller="video" data-video-id-value="3sTkU9dWKgM">
    <img src="/images/site/disfruta-del-momento.jpg" alt="<%= t('home.events_title') %>" width="1200" height="735" loading="lazy">
    <button type="button" class="video-play" data-action="video#play" aria-label="<%= t('common.play_video') %>">▶</button>
  </div>
</div>

<div class="container section">
  <h2><%= t('home.blog_title') %></h2>
  <div class="grid">
    <%= render partial: 'blog/card', collection: @posts, as: :post %>
  </div>
</div>
