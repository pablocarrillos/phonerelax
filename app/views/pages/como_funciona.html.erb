<% content_for :title, "#{t('how_it_works.title')} · PhoneRelax" %>
<% content_for :description, t('how_it_works.meta_description') %>

<% faqs = (1..5).map { |i| [t("how_it_works.faq.q#{i}"), t("how_it_works.faq.a#{i}")] } %>

<% content_for :json_ld do %>
  <%= json_ld_tag(
        '@context' => 'https://schema.org',
        '@type' => 'FAQPage',
        'mainEntity' => faqs.map { |q, a|
          { '@type' => 'Question', 'name' => q,
            'acceptedAnswer' => { '@type' => 'Answer', 'text' => a } }
        }
      ) %>
<% end %>
<div class="container section">
  <h1><%= t('how_it_works.title') %></h1>
  <p><%= t('how_it_works.p1') %></p>
  <p><%= t('how_it_works.p2') %></p>
  <p><%= t('how_it_works.p3') %></p>
  <p><%= t('how_it_works.p4') %></p>
</div>

<div class="container section">
  <div class="video-block" data-controller="video" data-video-id-value="3sTkU9dWKgM">
    <img src="/images/site/disfruta-del-momento.jpg" alt="<%= t('how_it_works.video_alt') %>" width="1200" height="735" loading="lazy">
    <button type="button" class="video-play" data-action="video#play" aria-label="<%= t('common.play_video') %>">▶</button>
  </div>
</div>

<section class="container section faq" aria-labelledby="faq-title">
  <h2 id="faq-title"><%= t('how_it_works.faq_title') %></h2>
  <% faqs.each do |question, answer| %>
    <details class="faq-item">
      <summary><%= question %></summary>
      <p><%= answer %></p>
    </details>
  <% end %>
</section>

<%= render 'shared/steps' %>
