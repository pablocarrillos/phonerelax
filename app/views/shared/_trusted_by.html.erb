<div class="container section">
  <div class="trusted-by">
    <p class="trusted-title"><%= t('common.trusted_by') %></p>
    <ul class="trusted-logos">
      <% trusted_clients.each do |name| %>
        <li>
          <% if (logo = trusted_client_logo(name)) %>
            <%= image_tag logo, alt: name, title: name, class: 'trusted-logo', loading: 'lazy' %>
          <% else %>
            <%= name %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
</div>
