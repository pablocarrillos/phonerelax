<div class="container section">
  <div class="trusted-by">
    <p class="trusted-title"><%= t('common.trusted_by') %></p>
    <%# Carrusel infinito: dos tiras idénticas desplazándose en bucle; cuando la
        primera sale entera por la izquierda el ciclo reinicia sin salto. La
        segunda copia es decorativa (aria-hidden). Los laterales se desvanecen
        con una máscara de degradado (ver .trusted-carousel en el CSS). %>
    <div class="trusted-carousel">
      <div class="trusted-track">
        <% 2.times do |copy| %>
          <ul class="trusted-strip"<%= ' aria-hidden="true"'.html_safe if copy == 1 %>>
            <% trusted_clients.each do |name| %>
              <li>
                <% if (logo = trusted_client_logo(name)) %>
                  <%= image_tag logo, alt: copy.zero? ? name : '', title: name, class: "trusted-logo trusted-logo--#{name.parameterize}", loading: 'lazy' %>
                <% else %>
                  <%= name %>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
    </div>
  </div>
</div>
