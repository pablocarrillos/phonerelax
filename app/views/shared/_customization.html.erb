<div class="container section">
  <h2><%= t('quote.customization_title') %></h2>
  <p style="max-width:760px;"><%= t('quote.customization_body') %></p>
  <% examples = customization_examples %>
  <% if examples.any? %>
    <div class="grid personalizacion-grid" id="personalizacion-ejemplos">
      <% examples.each do |ex| %>
        <figure class="personalizacion-card">
          <img src="/images/personalizacion/<%= ex[:file] %>"
               alt="<%= t('quote.customization_alt', name: ex[:name]) %>" loading="lazy">
          <figcaption><%= ex[:name] %></figcaption>
        </figure>
      <% end %>
    </div>
  <% end %>
</div>
