<div class="container section">
  <h2><%= t('steps.title') %></h2>
  <div class="grid">
    <div class="card step-card">
      <img src="/images/site/paso-1-mete-el-telefono.jpg" alt="<%= t('steps.step1_alt') %>" class="step-img" width="800" height="1067" loading="lazy">
      <h3><%= t('steps.step1_title') %></h3>
      <p class="step"><%= t('steps.step1_body') %></p>
    </div>
    <div class="card step-card">
      <img src="/images/site/paso-2-cierra-la-bolsa.jpg" alt="<%= t('steps.step2_alt') %>" class="step-img" width="755" height="1006" loading="lazy">
      <h3><%= t('steps.step2_title') %></h3>
      <p class="step"><%= t('steps.step2_body') %></p>
    </div>
    <div class="card step-card">
      <img src="/images/site/paso-3-abre-la-bolsa.jpg" alt="<%= t('steps.step3_alt') %>" class="step-img" width="800" height="1000" loading="lazy">
      <h3><%= t('steps.step3_title') %></h3>
      <p class="step"><%= t('steps.step3_body') %></p>
    </div>
  </div>
  <p style="margin-top: 26px;"><%= link_to t('common.our_products'), root_path(anchor: 'productos'), class: 'btn btn-primary btn-block' %></p>
</div>
