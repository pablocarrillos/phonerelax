<% content_for :title, "#{t('order.title', number: @order.number)} · PhoneRelax" %>
<% content_for :robots, 'noindex, nofollow' %>
<div class="container section" style="max-width: 760px;">
  <h1><%= t('order.title', number: @order.number) %></h1>
  <p>
    <%= t('order.payment') %> <span class="badge <%= @order.payment_status %>"><%= t("order.payment_statuses.#{@order.payment_status}", default: @order.payment_status) %></span>
    &nbsp; <%= t('order.status') %> <span class="badge <%= @order.status %>"><%= t("order.statuses.#{@order.status}", default: @order.status) %></span>
  </p>

  <div class="status-steps">
    <% Order.statuses.keys.each do |step| %>
      <div class="status-step <%= 'done' if Order.statuses[@order.status] >= Order.statuses[step] %>"><%= t("order.statuses.#{step}", default: step.capitalize) %></div>
    <% end %>
  </div>

  <table class="table">
    <tbody>
      <% @order.order_lines.each do |line| %>
        <tr>
          <td><%= line.product.name %> × <%= line.quantity %></td>
          <td class="num"><%= number_to_currency(line.subtotal, unit: '€', format: '%n %u') %></td>
        </tr>
      <% end %>
      <% if @order.shipping_cost.positive? %>
        <tr><td><%= t('order.shipping') %></td><td class="num"><%= number_to_currency(@order.shipping_cost, unit: '€', format: '%n %u') %></td></tr>
      <% end %>
      <tr class="total-row"><td><%= t('common.total') %></td><td class="num"><%= number_to_currency(@order.total, unit: '€', format: '%n %u') %></td></tr>
    </tbody>
  </table>

  <p style="color: var(--muted); font-size: 14px;"><%= t('order.save_note') %></p>
</div>
