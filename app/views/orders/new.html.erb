<% content_for :title, "#{t('checkout.title')} · PhoneRelax" %>
<% content_for :robots, 'noindex, follow' %>
<div class="container section" style="max-width: 760px;"
     data-controller="invoice" data-invoice-vies-url-value="<%= vies_check_path %>">
  <h1><%= t('checkout.title') %></h1>
  <%# Cada importe del resumen lleva su variante con IVA (gross) y sin IVA (net):
      el JS muestra una u otra según el destino y el resultado de VIES. %>
  <% net_total = @lines.sum { |product, quantity| product.net_price_for_quantity(quantity) * quantity } %>

  <table class="table">
    <tbody>
      <% @lines.each do |product, quantity| %>
        <tr>
          <td>
            <div class="line-cell">
              <img src="<%= product.cover_url %>" alt="<%= product.display_name %>" class="line-thumb">
              <span><%= product.display_name %> × <%= quantity %></span>
            </div>
          </td>
          <td class="num" data-invoice-target="amount"
              data-gross="<%= number_to_currency(product.price_for_quantity(quantity) * quantity, unit: '€', format: '%n %u') %>"
              data-net="<%= number_to_currency(product.net_price_for_quantity(quantity) * quantity, unit: '€', format: '%n %u') %>"><%= number_to_currency(product.price_for_quantity(quantity) * quantity, unit: '€', format: '%n %u') %></td>
        </tr>
      <% end %>
      <% vat_total = @lines.sum { |product, quantity| p = product.price_for_quantity(quantity); (p - p / (1 + product.vat_percentage / 100)) * quantity } %>
      <tr><td><%= t('checkout.base') %></td>
          <td class="num" data-invoice-target="amount"
              data-gross="<%= number_to_currency(@total - vat_total, unit: '€', format: '%n %u') %>"
              data-net="<%= number_to_currency(net_total, unit: '€', format: '%n %u') %>"><%= number_to_currency(@total - vat_total, unit: '€', format: '%n %u') %></td></tr>
      <% vat_rates = @lines.map { |product, _| product.vat_percentage }.uniq %>
      <% vat_label = vat_rates.one? ? t('common.vat_rate', rate: vat_rates.first.to_s.sub(/\.0+\z/, '')) : t('checkout.vat') %>
      <tr><td data-invoice-target="amount" data-gross="<%= vat_label %>" data-net="<%= t('common.vat_rate', rate: 0) %>"><%= vat_label %></td>
          <td class="num" data-invoice-target="amount"
              data-gross="<%= number_to_currency(vat_total, unit: '€', format: '%n %u') %>"
              data-net="<%= number_to_currency(0, unit: '€', format: '%n %u') %>"><%= number_to_currency(vat_total, unit: '€', format: '%n %u') %></td></tr>
      <% if @coupon %>
        <% coupon_gross = @coupon.discount_for(@total) %>
        <% coupon_net = @coupon.discount_for(net_total) %>
        <tr>
          <td style="color:#0a7d43;"><%= t('checkout.coupon_row', default: 'Cupón') %> <strong style="font-family:monospace;"><%= @coupon.code %></strong>
            · <%= link_to t('checkout.coupon_remove', default: 'Quitar'), coupon_remove_path, data: { turbo_method: :delete }, style: 'font-size:13px;' %></td>
          <td class="num" style="color:#0a7d43;" data-invoice-target="amount"
              data-gross="−<%= number_to_currency(coupon_gross, unit: '€', format: '%n %u') %>"
              data-net="−<%= number_to_currency(coupon_net, unit: '€', format: '%n %u') %>">−<%= number_to_currency(coupon_gross, unit: '€', format: '%n %u') %></td>
        </tr>
      <% end %>
      <% total_gross = @coupon ? @total - @coupon.discount_for(@total) : @total %>
      <% total_net = @coupon ? net_total - @coupon.discount_for(net_total) : net_total %>
      <tr class="total-row">
        <td data-invoice-target="totalLabel"
            data-gross="<%= t('checkout.total_vat') %>" data-net="<%= t('checkout.total_exempt') %>"><%= t('checkout.total_vat') %></td>
        <td class="num" data-invoice-target="amount"
            data-gross="<%= number_to_currency(total_gross, unit: '€', format: '%n %u') %>"
            data-net="<%= number_to_currency(total_net, unit: '€', format: '%n %u') %>"><%= number_to_currency(total_gross, unit: '€', format: '%n %u') %></td>
      </tr>
    </tbody>
  </table>

  <% if !@coupon && Coupon.where(enabled: true).exists? %>
    <%# solo se enseña si hay cupones definidos; el botón valida en el servidor %>
    <details style="margin: 4px 0 14px;">
      <summary style="cursor:pointer; color:var(--primary, #0E1B4D); font-weight:600;"><%= t('checkout.coupon_question', default: '¿Tienes un cupón?') %></summary>
      <div style="display:flex; gap:8px; align-items:center; margin-top:10px; flex-wrap:wrap;">
        <input type="text" id="coupon-code" class="input-compact" style="max-width:200px; text-transform:uppercase; font-family:monospace;"
               placeholder="<%= t('checkout.coupon_placeholder', default: 'Código') %>">
        <button type="button" class="btn btn-outline" id="coupon-apply" style="padding:6px 16px;"><%= t('checkout.coupon_use', default: 'Usar') %></button>
        <span id="coupon-feedback" style="font-size:14px;"></span>
      </div>
    </details>
    <script>
      (function () {
        var button = document.getElementById("coupon-apply");
        var input = document.getElementById("coupon-code");
        var feedback = document.getElementById("coupon-feedback");
        if (!button) { return; }
        function apply() {
          var code = input.value.trim();
          if (!code) { return; }
          var token = document.querySelector("meta[name=csrf-token]").content;
          fetch("<%= coupon_validate_path %>", {
            method: "POST", credentials: "same-origin",
            headers: { "Content-Type": "application/json", "X-CSRF-Token": token, "Accept": "application/json" },
            body: JSON.stringify({ code: code })
          }).then(function (r) { return r.json(); }).then(function (data) {
            feedback.textContent = data.message;
            feedback.style.color = data.valid ? "#0a7d43" : "#c0392b";
            if (data.valid) { setTimeout(function () { window.location.reload(); }, 600); }
          }).catch(function () { feedback.textContent = "No se pudo comprobar el cupón."; feedback.style.color = "#c0392b"; });
        }
        button.addEventListener("click", apply);
        input.addEventListener("keydown", function (e) { if (e.key === "Enter") { e.preventDefault(); apply(); } });
      })();
    </script>
  <% end %>

  <p class="shipping-note" data-invoice-target="exemptNote" hidden
     data-export="<%= t('vat_exempt.export') %>" data-intra="<%= t('vat_exempt.intra_eu') %>"></p>
  <p class="shipping-note"><%= t('checkout.shipping_note') %></p>

  <h2 style="margin-top: 30px;"><%= t('checkout.your_data') %></h2>
  <%= form_with model: @order, url: orders_path, local: true do |f| %>
    <%= invisible_captcha %>
    <% if @order.errors.any? %>
      <div class="errors"><ul><% @order.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul></div>
    <% end %>
    <div class="form-grid">
      <div><%= f.label :customer_name, t('checkout.customer_name') %><%= f.text_field :customer_name, required: true %></div>
      <div><%= f.label :email, t('checkout.email') %><%= f.email_field :email, required: true %></div>
      <div>
        <%= f.label :phone, t('checkout.phone') %>
        <div class="phone-row">
          <% selected_iso = @order.phone_prefix_iso || Order::LOCALE_PHONE_COUNTRY[I18n.locale.to_s] || 'ES' %>
          <select name="order[phone_prefix]" class="form-select phone-prefix" aria-label="<%= t('checkout.phone_prefix') %>">
            <% Order::PHONE_PREFIXES.each do |iso, prefix| %>
              <option value="<%= iso %>" <%= 'selected' if iso == selected_iso %>><%= country_flag(iso) %> <%= prefix %></option>
            <% end %>
          </select>
          <%= f.telephone_field :phone, required: true, value: @order.phone_without_prefix %>
        </div>
      </div>
      <div class="full"><%= f.label :address, t('checkout.address') %><%= f.text_field :address, required: true %></div>
      <div><%= f.label :city, t('checkout.city') %><%= f.text_field :city, required: true %></div>
      <div><%= f.label :postal_code, t('checkout.postal_code') %><%= f.text_field :postal_code, required: true %></div>
      <div><%= f.label :province, t('checkout.province') %><%= f.text_field :province, required: true %></div>
      <div><%= f.label :country, t('checkout.country') %><%= f.select :country, Order::EU_COUNTRIES, { selected: @order.country || 'España (Península)' }, { class: 'form-select', data: { invoice_target: 'country', action: 'change->invoice#refresh' } } %></div>
    </div>

    <div class="invoice-block">
      <label class="invoice-check">
        <%= f.check_box :needs_invoice, data: { invoice_target: 'checkbox', action: 'change->invoice#toggle' } %>
        <span><%= t('checkout.needs_invoice') %></span>
      </label>
      <div class="invoice-fields" data-invoice-target="fields" hidden>
        <p class="action-note" style="margin-top:0;"><%= t('checkout.invoice_note') %></p>
        <div class="form-grid">
          <div class="full"><%= f.label :tax_name, t('checkout.tax_name') %><%= f.text_field :tax_name, data: { required: true } %></div>
          <div class="full">
            <%= f.label :tax_id, t('checkout.tax_id') %>
            <%= f.text_field :tax_id, data: { invoice_target: 'taxId', required: true, action: 'change->invoice#checkVies input->invoice#clearVies' } %>
            <span class="vies-status" data-invoice-target="viesStatus"
                  data-checking="<%= t('checkout.vies_checking') %>" data-ok="<%= t('checkout.vies_ok') %>"
                  data-ko="<%= t('checkout.vies_ko') %>" data-unavailable="<%= t('checkout.vies_unavailable') %>"></span>
          </div>
          <div class="full">
            <label class="invoice-check">
              <input type="checkbox" data-action="change->invoice#copyShipping">
              <span><%= t('checkout.tax_same_as_shipping') %></span>
            </label>
          </div>
          <div class="full"><%= f.label :tax_address, t('checkout.tax_address') %><%= f.text_field :tax_address, data: { required: true } %></div>
          <div><%= f.label :tax_city, t('checkout.tax_city') %><%= f.text_field :tax_city, data: { required: true } %></div>
          <div><%= f.label :tax_postal_code, t('checkout.tax_postal_code') %><%= f.text_field :tax_postal_code, data: { required: true } %></div>
          <div><%= f.label :tax_province, t('checkout.tax_province') %><%= f.text_field :tax_province, data: { required: true } %></div>
          <div><%= f.label :tax_country, t('checkout.tax_country') %><%= f.select :tax_country, Order::EU_COUNTRIES, { include_blank: true }, { class: 'form-select', data: { required: true } } %></div>
        </div>
      </div>
    </div>

    <%= f.submit t('checkout.submit'), class: 'btn btn-magenta btn-block', style: 'font-size: 17px;' %>
  <% end %>
</div>
