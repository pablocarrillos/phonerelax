<% content_for :title, "#{t('checkout.title')} · PhoneRelax" %>
<% content_for :robots, 'noindex, follow' %>
<div class="container section" style="max-width: 760px;">
  <h1><%= t('checkout.title') %></h1>

  <table class="table">
    <tbody>
      <% @lines.each do |product, quantity| %>
        <tr>
          <td>
            <div class="line-cell">
              <img src="<%= product.cover_url %>" alt="<%= product.display_name %>" class="line-thumb">
              <span><%= product.display_name %> × <%= quantity %></span>
            </div>
          </td>
          <td class="num"><%= number_to_currency(product.price_for_quantity(quantity) * quantity, unit: '€', format: '%n %u') %></td>
        </tr>
      <% end %>
      <% vat_total = @lines.sum { |product, quantity| p = product.price_for_quantity(quantity); (p - p / (1 + product.vat_percentage / 100)) * quantity } %>
      <tr><td><%= t('checkout.base') %></td><td class="num"><%= number_to_currency(@total - vat_total, unit: '€', format: '%n %u') %></td></tr>
      <tr><td><%= t('checkout.vat') %></td><td class="num"><%= number_to_currency(vat_total, unit: '€', format: '%n %u') %></td></tr>
      <tr class="total-row"><td><%= t('checkout.total_vat') %></td><td class="num"><%= number_to_currency(@total, unit: '€', format: '%n %u') %></td></tr>
    </tbody>
  </table>
  <p class="shipping-note"><%= t('checkout.shipping_note') %></p>

  <h2 style="margin-top: 30px;"><%= t('checkout.your_data') %></h2>
  <%= form_with model: @order, url: orders_path, local: true do |f| %>
    <%= invisible_captcha %>
    <% if @order.errors.any? %>
      <div class="errors"><ul><% @order.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul></div>
    <% end %>
    <div class="form-grid">
      <div><%= f.label :customer_name, t('checkout.customer_name') %><%= f.text_field :customer_name, required: true %></div>
      <div><%= f.label :email, t('checkout.email') %><%= f.email_field :email, required: true %></div>
      <div><%= f.label :phone, t('checkout.phone') %><%= f.telephone_field :phone, required: true %></div>
      <div class="full"><%= f.label :address, t('checkout.address') %><%= f.text_field :address, required: true %></div>
      <div><%= f.label :city, t('checkout.city') %><%= f.text_field :city, required: true %></div>
      <div><%= f.label :postal_code, t('checkout.postal_code') %><%= f.text_field :postal_code, required: true %></div>
      <div><%= f.label :province, t('checkout.province') %><%= f.text_field :province, required: true %></div>
      <div><%= f.label :country, t('checkout.country') %><%= f.select :country, Order::EU_COUNTRIES, { selected: @order.country || 'España (Península)' }, { class: 'form-select' } %></div>
    </div>

    <div class="invoice-block" data-controller="invoice" data-invoice-vies-url-value="<%= vies_check_path %>">
      <label class="invoice-check">
        <%= f.check_box :needs_invoice, data: { invoice_target: 'checkbox', action: 'change->invoice#toggle' } %>
        <span><%= t('checkout.needs_invoice') %></span>
      </label>
      <div class="invoice-fields" data-invoice-target="fields" hidden>
        <p class="action-note" style="margin-top:0;"><%= t('checkout.invoice_note') %></p>
        <div class="form-grid">
          <div class="full"><%= f.label :tax_name, t('checkout.tax_name') %><%= f.text_field :tax_name, data: { required: true } %></div>
          <div class="full">
            <%= f.label :tax_id, t('checkout.tax_id') %>
            <%= f.text_field :tax_id, data: { invoice_target: 'taxId', required: true, action: 'change->invoice#checkVies input->invoice#clearVies' } %>
            <span class="vies-status" data-invoice-target="viesStatus"
                  data-checking="<%= t('checkout.vies_checking') %>" data-ok="<%= t('checkout.vies_ok') %>"
                  data-ko="<%= t('checkout.vies_ko') %>" data-unavailable="<%= t('checkout.vies_unavailable') %>"></span>
          </div>
          <div class="full">
            <label class="invoice-check">
              <input type="checkbox" data-action="change->invoice#copyShipping">
              <span><%= t('checkout.tax_same_as_shipping') %></span>
            </label>
          </div>
          <div class="full"><%= f.label :tax_address, t('checkout.tax_address') %><%= f.text_field :tax_address, data: { required: true } %></div>
          <div><%= f.label :tax_city, t('checkout.tax_city') %><%= f.text_field :tax_city, data: { required: true } %></div>
          <div><%= f.label :tax_postal_code, t('checkout.tax_postal_code') %><%= f.text_field :tax_postal_code, data: { required: true } %></div>
          <div><%= f.label :tax_province, t('checkout.tax_province') %><%= f.text_field :tax_province, data: { required: true } %></div>
          <div><%= f.label :tax_country, t('checkout.tax_country') %><%= f.select :tax_country, Order::EU_COUNTRIES, { include_blank: true }, { class: 'form-select', data: { required: true } } %></div>
        </div>
      </div>
    </div>

    <%= f.submit t('checkout.submit'), class: 'btn btn-magenta btn-block', style: 'font-size: 17px;' %>
  <% end %>
</div>
